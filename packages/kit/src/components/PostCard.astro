---
/** A post in the blog index and in "Sigue leyendo": photo (or a small orbit), category, reading time, title, summary. */
import { Image } from 'astro:assets';
import { categoryOf, categoryTint, postHref, readingMinutes, type Blog, type Post } from '../blog';
interface Props { post: Post; blog: Blog; compact?: boolean }
const { post, blog, compact = false } = Astro.props;
const cat = categoryOf(blog, post);
---
<a class:list={['pcard', { compact }]} href={postHref(blog, post)} data-cat={cat.id}>
  {post.data.image
    ? <figure class="duo pc-img" style={`--tint: ${categoryTint(blog, cat.id)}`}><Image src={post.data.image as never} alt={post.data.alt!} widths={[400, 720]} sizes="(max-width: 900px) 100vw, 33vw" /></figure>
    : <div class="pc-img pc-art stars" aria-hidden="true"><svg viewBox="0 0 200 120" width="200" height="120"><ellipse cx="100" cy="64" rx="84" ry="20" fill="none" stroke="rgba(255,255,255,.12)" transform="rotate(-10 100 64)" /><circle cx="100" cy="64" r="30" fill="#0E1C24" stroke="rgba(91,240,200,.4)" /><g transform="translate(176 26) rotate(-20)"><path d="M0 0 L-12 -4 L-9 0 L-12 4 Z" fill="#ECEFF4" /><path d="M-9 0 L-17 0" stroke="#F2C879" stroke-width="2" stroke-linecap="round" /></g></svg></div>}
  <span class="pc-body">
    <span class="pc-meta"><span class="pill">{cat.label}</span>{!compact && <span>{blog.readingTime.replace('{n}', String(readingMinutes(post)))}</span>}</span>
    <b>{post.data.title}</b>
    {!compact && <span class="pc-sum">{post.data.summary}</span>}
  </span>
</a>
