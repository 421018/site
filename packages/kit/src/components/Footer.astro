---
import { getFooter, getSiteText } from '../site';
import { getBlog, getPosts, postHref, categoryOf } from '../blog';
import { langOf, resolveHref } from '../i18n';
const lang = langOf(Astro);
const columns = await getFooter(lang);
// Posts whose category has a path (e.g. use-cases) are listed in that section's column.
const blog = await getBlog(lang);
if (blog) {
  for (const p of await getPosts(lang)) {
    const col = columns.find((c) => c.key === categoryOf(blog, p).path);
    col?.links.push({ href: postHref(blog, p), label: p.data.title });
  }
}
const text = await getSiteText(lang);
if (text.footer.extra) columns.push({ key: '', label: text.footer.extra.label, links: text.footer.extra.links.map((l) => ({ ...l, href: resolveHref(l.href, lang) })) });
---
<footer class="site-footer">
  <div class="inner">
    <slot />
    <div class="fcols">
      {columns.map((col) => (
        <div>
          <p class="lbl">{col.label}</p>
          {col.links.map((l) => <a class="flink" href={l.href}>{l.label}</a>)}
        </div>
      ))}
    </div>
    <div aria-hidden="true" class="megatype">{text.name}</div>
    <div class="fbase"><span>{text.name} · {text.footer.credit} · {text.footer.license}</span><span>{text.footer.note}</span></div>
  </div>
</footer>
