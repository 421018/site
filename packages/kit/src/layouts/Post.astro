---
/**
 * A blog post: dark band with category, reading time, date, title and
 * summary; the cover photo; the text on the reading surface with "En esta
 * entrada" (its h2 headings); and related posts.
 */
import { Image } from 'astro:assets';
import kit from 'virtual:42chain/kit';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { catalogRelative } from '../catalog';
import { homeHref, langPrefix, sourceLang, withLang } from '../i18n';
import { getSiteText } from '../site';
import { blogHref, categoryOf, categoryTint, postDate, postHref, postLang, readingMinutes, relatedPosts, type Blog, type Post } from '../blog';
interface Props { post: Post; blog: Blog; headings: { depth: number; slug: string; text: string }[] }
const { post, blog, headings } = Astro.props;
const lang = postLang(post);
const cat = categoryOf(blog, post);
const published = postDate(post);
const date = published && new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(published);
const toc = headings.filter((h) => h.depth === 2);
const related = await relatedPosts(post);
const { header: { home }, page: ui } = await getSiteText(lang);
const original = post.fallbackOf;
const canonicalHref = original ? withLang(postHref(blog, post).replace(langPrefix(lang), '') || '/', sourceLang) : undefined;
const index = blogHref(blog, lang);
// A category with its own path (use-cases) belongs to that section; the others to the blog.
const catHref = cat.path ? `${langPrefix(lang)}/${cat.path}` : `${index}#${cat.id}`;
---
<Base title={post.data.title} description={post.data.summary} canonicalHref={canonicalHref}>
  <section class="band-top post-band stars">
    <Header current={cat.path} currentHref={cat.path ? undefined : index} />
    <div class="post-head">
      <nav class="crumbs" aria-label={cat.path ? cat.plural : blog.kicker}>{home && <><a href={homeHref(lang)}>{home}</a> <span aria-hidden="true">/</span> </>}{cat.path ? <a href={catHref}>{cat.plural}</a> : <><a href={index}>{blog.kicker}</a> <span aria-hidden="true">/</span> <a href={catHref}>{cat.plural}</a></>}</nav>
      <p class="post-meta"><span class="pill">{cat.label}</span><span>{blog.readingTime.replace('{n}', String(readingMinutes(post)))}</span>{date && <span>{date}</span>}</p>
      <h1>{post.data.title}</h1>
      <p class="post-sum">{post.data.summary}</p>
      <p class="post-by">{blog.byline} · <a href={kit.editBase + catalogRelative(post.filePath!)}>{blog.editPost}</a></p>
    </div>
  </section>
  <div class="rd">
    {post.data.image && (
      <figure class="post-cover">
        <div class="duo" style={`--tint: ${categoryTint(blog, cat.id)}`}><Image src={post.data.image as never} alt={post.data.alt!} widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 1100px" /></div>
        <figcaption>{blog.illustrative} {post.data.credit}.</figcaption>
      </figure>
    )}
    <div class="lay post-lay">
      {toc.length > 1 && (
        <aside class="post-toc">
          <p>{blog.onThisPost}</p>
          <nav aria-label={blog.onThisPost}>{toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
        </aside>
      )}
      <main data-pagefind-body={kit.search && !original ? true : undefined} lang={original ? sourceLang : undefined}>
        {original && ui.untranslated && <p class="untranslated" lang={lang}>{ui.untranslated}</p>}
        <div class="prose"><slot /></div>
      </main>
    </div>
    {related.length > 0 && (
      <section class="post-more">
        <p class="pm-k">{blog.keepReading}</p>
        <div class="pm-grid">{related.map((r) => <PostCard post={r} blog={blog} compact />)}</div>
      </section>
    )}
  </div>
  <Footer />
</Base>
