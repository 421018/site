---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SideNav from '../components/SideNav.astro';
import { getAlternates, getSection, getSiteText, sideIndex, prevNext, hrefOf, pageLang, sectionKey, lastCommitDate, type Page } from '../site';
import kit from 'virtual:42chain/kit';
import { catalogRelative } from '../catalog';

interface Props { page: Page }
const { page } = Astro.props;
const lang = pageLang(page);
const section = await getSection(lang, sectionKey(page));
const home = await getSection(lang, section.home);
const alternates = await getAlternates(page);
const nav = sideIndex(home);
const showSide = nav.items.length + nav.refs.length > 1;
const path = hrefOf(page);
const { prev, next } = prevNext(section, page);
const updated = page.data.updated ?? lastCommitDate(page.filePath);
const fmt = updated && new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(updated);
const { page: ui } = await getSiteText(lang);
---
<Base title={page.data.title} description={page.data.summary} accent={section.accent} ink={section.ink} alternates={alternates}>
  <section class="band-top">
    <div class="band-deco" aria-hidden="true"><div class="gridbg"></div><div class="glow"></div></div>
    <Header current={home.key} alternates={alternates} />
  </section>
  <div class="rd">
    <div class="lay">
      {showSide && <SideNav nav={nav} path={path} />}
      <main data-pagefind-body={kit.search ? true : undefined}>
        <div class="dochead">
          <p class="dk">{section.label}</p>
          <h1>{page.data.title}</h1>
          <p class="ds">{page.data.summary}</p>
          <p class="dm">{fmt && <>{ui.lastReviewed}: {fmt} · </>}<a href={kit.editBase + catalogRelative(page.filePath!)}>{ui.editPage}</a></p>
        </div>
        <div class="prose">
          <slot />
        </div>
        {(prev || next) && (
          <nav class="pn" aria-label={ui.chapters}>
            {prev && <a class="pv" href={prev.href}><span>{ui.previous}</span>{prev.label}</a>}
            {next && <a class="nx" href={next.href}><span>{ui.next}</span>{next.label}</a>}
          </nav>
        )}
      </main>
    </div>
  </div>
  <Footer />
</Base>
