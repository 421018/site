---
/**
 * The posts of the section this page belongs to, as cards: a category whose
 * path is this section (site.md → blog.categories, e.g. casos-de-uso).
 */
import PostCard from '@42chain/kit/components/PostCard.astro';
import { getBlog, getPosts, categoryOf } from '@42chain/kit/blog';
import { langOf, langPrefix } from '@42chain/kit/i18n';
const lang = langOf(Astro);
const blog = await getBlog(lang);
const section = Astro.url.pathname.slice(langPrefix(lang).length).split('/').filter(Boolean)[0];
const posts = blog ? (await getPosts(lang)).filter((p) => categoryOf(blog, p).path === section) : [];
if (!blog || !posts.length) throw new Error(`:::widget{name="case-gallery"} on /${section}: no posts whose category has path "${section}".`);
---
<div class="case-gallery">{posts.map((p) => <PostCard post={p} blog={blog} />)}</div>
