---
/** Small planet, orbit and two blocks for the band at the top of interior pages. Decorative; hidden on narrow screens. */
---
<svg class="band-orbit" aria-hidden="true" viewBox="0 0 520 300">
  <ellipse cx="300" cy="170" rx="220" ry="58" fill="none" stroke="rgba(255,255,255,.10)" transform="rotate(-10 300 170)" />
  <circle cx="300" cy="170" r="88" fill="#0E1C24" stroke="color-mix(in srgb, var(--acc) 40%, transparent)" />
  <path d="M218 188 Q300 162 382 142" fill="none" stroke="rgba(255,255,255,.05)" stroke-width="12" />
  <g fill="#0B1018" stroke="var(--acc)" stroke-opacity=".7"><rect x="92" y="206" width="14" height="14" rx="3" /><rect x="146" y="224" width="14" height="14" rx="3" /></g>
  <path d="M106 213 L146 231" stroke="color-mix(in srgb, var(--acc) 35%, transparent)" />
  <g transform="translate(480 58) rotate(-18)"><path d="M0 0 L-14 -5 L-10 0 L-14 5 Z" fill="#ECEFF4" /><path d="M-10 0 L-19 0" stroke="#F2C879" stroke-width="2" stroke-linecap="round" /></g>
</svg>
