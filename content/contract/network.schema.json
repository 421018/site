{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "label": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "evmChainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "chainId": {
      "type": "string"
    },
    "identifier": {
      "type": "string"
    },
    "bech32Prefix": {
      "type": "string"
    },
    "unit": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "decimals": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "base": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "symbol",
        "decimals",
        "base"
      ],
      "additionalProperties": false
    },
    "blockTime": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "id",
    "label",
    "name",
    "evmChainId",
    "chainId",
    "identifier",
    "bech32Prefix",
    "unit",
    "blockTime",
    "data"
  ],
  "additionalProperties": false
}
