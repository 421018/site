{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "menuTitle": {
      "type": "string"
    },
    "weight": {
      "default": 100,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updated": {},
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "translationOf": {
      "type": "string"
    },
    "section": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "numbered": {
          "default": false,
          "type": "boolean"
        },
        "sequential": {
          "default": false,
          "type": "boolean"
        },
        "links": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          }
        },
        "attachTo": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "weight"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "summary"
  ],
  "additionalProperties": false
}
