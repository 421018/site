{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "anchor": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "label": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "emptyNote": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "anchor",
    "label",
    "description"
  ],
  "additionalProperties": false
}
