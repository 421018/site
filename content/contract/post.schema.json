{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "date": {},
    "image": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "credit": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "summary",
    "category"
  ],
  "additionalProperties": false
}
