{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "language": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "header": {
      "type": "object",
      "properties": {
        "homeLink": {
          "type": "string"
        },
        "mainNav": {
          "type": "string"
        },
        "menuButton": {
          "type": "string"
        },
        "languageNav": {
          "type": "string"
        },
        "submenu": {
          "type": "string"
        },
        "links": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          }
        },
        "cta": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ],
          "additionalProperties": false
        },
        "search": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "noResults": {
              "type": "string"
            },
            "unavailable": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "close",
            "noResults",
            "unavailable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "homeLink",
        "mainNav",
        "menuButton",
        "languageNav"
      ],
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "properties": {
        "credit": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "credit",
        "license",
        "note"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "lastReviewed": {
          "type": "string"
        },
        "editPage": {
          "type": "string"
        },
        "previous": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "chapters": {
          "type": "string"
        }
      },
      "required": [
        "lastReviewed",
        "editPage",
        "previous",
        "next",
        "chapters"
      ],
      "additionalProperties": false
    },
    "notFound": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "label",
        "heading",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "language",
    "name",
    "tagline",
    "description",
    "header",
    "footer",
    "page",
    "notFound"
  ],
  "additionalProperties": false
}
