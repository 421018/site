---
/** Ringed planet with a small ship passing by: the lore band ("¿Por qué 42?"). Decorative. */
---
<svg class="ringed" aria-hidden="true" viewBox="0 0 520 380">
  <ellipse cx="300" cy="200" rx="190" ry="44" fill="none" stroke="rgba(242,200,121,.45)" stroke-width="1.5" transform="rotate(-12 300 200)" />
  <circle cx="300" cy="200" r="92" fill="#111A24" stroke="rgba(255,255,255,.12)" />
  <path d="M214 178 Q300 150 386 170" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="14" />
  <ellipse cx="300" cy="200" rx="190" ry="44" fill="none" stroke="rgba(242,200,121,.45)" stroke-width="1.5" stroke-dasharray="0 140 400" transform="rotate(-12 300 200)" />
  <circle cx="458" cy="74" r="10" fill="#1A2430" stroke="rgba(255,255,255,.2)" />
  <path d="M60 320 Q160 300 238 252" fill="none" stroke="rgba(242,200,121,.55)" stroke-dasharray="1 6" />
  <g transform="translate(244 248) rotate(-32)"><path d="M0 0 L-16 -6 L-12 0 L-16 6 Z" fill="#ECEFF4" /><path d="M-12 0 L-22 0" stroke="#F2C879" stroke-width="2" stroke-linecap="round" /></g>
</svg>
