---
/**
 * Brand icons: one stroke, one colour (currentColor), drawn on a 72-unit grid.
 * Decorative: always aria-hidden; the text next to them carries the meaning.
 */
import type { IconName } from './icons';
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 28, class: cls } = Astro.props;
---
<svg class={cls} aria-hidden="true" width={size} height={size} viewBox="0 0 72 72" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
  {name === 'execution' && <><path d="M36 10 L58 23 L58 49 L36 62 L14 49 L14 23 Z" /><rect x="27" y="27" width="18" height="18" rx="3" /></>}
  {name === 'consensus' && <><circle cx="36" cy="16" r="8" /><circle cx="14" cy="54" r="8" /><circle cx="58" cy="54" r="8" /><path d="M31 23 L18 47 M41 23 L54 47 M22 54 L50 54" /></>}
  {name === 'fees' && <><path d="M10 50 A26 26 0 0 1 62 50" /><path d="M36 50 L50 28" /><circle cx="36" cy="50" r="3" fill="currentColor" /></>}
  {name === 'interop' && <><circle cx="20" cy="44" r="13" /><circle cx="54" cy="26" r="9" /><path d="M31 36 Q40 18 46 24" stroke-dasharray="4 5" /></>}
  {name === 'governance' && <><rect x="12" y="34" width="48" height="28" rx="4" /><path d="M24 34 L24 26 L48 26 L48 34" /><path d="M28 12 L36 20 L52 4" /></>}
  {name === 'security' && <path d="M36 8 L60 18 V36 C60 51 49 61 36 64 C23 61 12 51 12 36 V18 Z" />}
  {name === 'connect' && <><circle cx="36" cy="36" r="26" /><path d="M46 26 L40 40 L26 46 L32 32 Z" /></>}
  {name === 'build' && <path d="M26 20 L10 36 L26 52 M46 20 L62 36 L46 52" />}
  {name === 'node' && <><rect x="12" y="12" width="48" height="18" rx="4" /><rect x="12" y="42" width="48" height="18" rx="4" /><path d="M22 21 H22.1 M22 51 H22.1" stroke-width="5" /></>}
  {name === 'integrate' && <><circle cx="20" cy="36" r="10" /><circle cx="52" cy="36" r="10" /><path d="M30 36 H42" /></>}
  {name === 'docs' && <><path d="M16 10 H46 L56 20 V62 H16 Z" /><path d="M26 34 H46 M26 44 H40" /></>}
  {name === 'cases' && <><rect x="10" y="18" width="52" height="40" rx="5" /><path d="M26 18 V12 H46 V18 M10 34 H62" /></>}
  {name === 'opensource' && <><circle cx="36" cy="36" r="26" /><path d="M28 30 L22 36 L28 42 M44 30 L50 36 L44 42" /></>}
</svg>
