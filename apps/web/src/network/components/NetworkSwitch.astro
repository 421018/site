---
// Switch between networks on a page. Elements marked data-for-net="<id>" are
// shown only for the selected network; without JavaScript everything is shown,
// each block under its own label. Several switches on a page stay in sync, and
// the choice is remembered in this browser when storage is available.
import { getDirectory, pick } from '../directory';
import { langOf } from '../../kit/i18n';
import { ui } from '../../kit/dictionary';
const lang = langOf(Astro);
const t = ui(lang).network;
const { networks } = await getDirectory();
const css = networks
  .map((n) => `html[data-net]:not([data-net="${n.id}"]) [data-for-net="${n.id}"]{display:none}`)
  .join('') + 'html[data-net] .net-cap{display:none}';
---
<div class="netsw" role="group" aria-label={t.switchLabel} data-netsw data-default={networks[0].id} hidden>
  {networks.map((n) => <button type="button" data-net-btn={n.id} aria-pressed="false">{pick(n.label, lang)}</button>)}
</div>
{/* Chooses the network as soon as the switch is parsed, before the blocks below it are painted:
    otherwise the first frame shows every network (the no-script view) and the page jumps when
    the module script runs. Same choice as the script below (stored, else the page's, else the default). */}
<script is:inline>(function(s){var d=document.documentElement,b=s.querySelectorAll('[data-net-btn]'),id=null,i,ok=false;try{id=localStorage.getItem('42chain-net')}catch(e){}for(i=0;i<b.length;i++)if(b[i].getAttribute('data-net-btn')===id)ok=true;if(!ok)id=d.dataset.net||s.getAttribute('data-default');d.dataset.net=id;for(i=0;i<b.length;i++)b[i].setAttribute('aria-pressed',String(b[i].getAttribute('data-net-btn')===id));s.hidden=false})(document.currentScript.previousElementSibling)</script>
<style is:global set:html={css}></style>
<style>
  /* a pill of two, like the header's switch between areas */
  .netsw { display: inline-flex; gap: 2px; padding: 3px; margin: 4px 0 20px; border: 1px solid var(--rule2); border-radius: 999px; background: transparent; }
  .netsw button { min-height: 34px; padding: 0 16px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; transition: color .2s, background .2s; }
  .netsw button:hover { color: var(--head); }
  .netsw button[aria-pressed="true"] { background: var(--soft); color: var(--head); font-weight: 600; box-shadow: inset 0 0 0 1px var(--rule2); }
  .netsw button:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
</style>
<script>
  const KEY = '42chain-net';
  const root = document.documentElement;
  const switches = [...document.querySelectorAll<HTMLElement>('[data-netsw]')];
  const set = (id: string) => {
    root.dataset.net = id;
    switches.forEach((s) => s.querySelectorAll<HTMLButtonElement>('[data-net-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.netBtn === id))));
    try { localStorage.setItem(KEY, id); } catch { /* storage unavailable: keep the choice for this page only */ }
  };
  if (switches.length) {
    const ids = [...switches[0].querySelectorAll<HTMLButtonElement>('[data-net-btn]')].map((b) => b.dataset.netBtn!);
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch { /* ignore */ }
    switches.forEach((s) => {
      s.hidden = false;
      s.querySelectorAll<HTMLButtonElement>('[data-net-btn]').forEach((b) => b.addEventListener('click', () => set(b.dataset.netBtn!)));
    });
    set(saved && ids.includes(saved) ? saved : switches[0].dataset.default!);
  }
</script>
