---
// Adds a network to an EVM wallet with EIP-3085 (wallet_addEthereumChain).
// Parameters come from networks.yaml; the RPC and explorer are the first evm and
// explorer entries of providers.yaml for that network. One button per network,
// filtered by <NetworkSwitch />.
import { getDirectory, allOf } from '../directory';
import { langOf } from '../../kit/i18n';
import { fill, ui } from '../../kit/dictionary';
const lang = langOf(Astro);
const d = ui(lang);
const t = d.network;
const i18n = JSON.stringify({ noWallet: t.noWallet, added: t.added, cancelled: t.cancelled, failed: t.addFailed });
const { networks, providers } = await getDirectory();
const buttons = networks.map((n) => {
  // The network's access points in the configured order: the first is used unless the visitor picks another.
  const rpcs = allOf(providers, n.id, 'evm');
  if (!rpcs.length) throw new Error(`providers.yaml: network "${n.id}" needs at least one evm provider for the wallet button.`);
  const explorer = allOf(providers, n.id, 'explorer')[0];
  return {
    id: n.id,
    label: fill(t.add, { name: n.name }),
    rpcs: rpcs.map((p) => ({ url: p.url, host: p.url.replace(/^https?:\/\//, ''), provider: p.provider })),
    params: {
      chainId: '0x' + n.evmChainId.toString(16),
      chainName: n.name,
      nativeCurrency: { name: n.unit.name, symbol: n.unit.symbol, decimals: n.unit.decimals },
      rpcUrls: [rpcs[0].url],
      ...(explorer ? { blockExplorerUrls: [explorer.url] } : {}),
    },
    chainIdDec: n.evmChainId,
  };
});
---
<div class="widget an" data-addnet data-i18n={i18n}>
  <div class="w-head"><span class="w-tag">{d.common.tool}</span><span class="w-meta">{t.addMeta}</span></div>
  <div class="btns">
    {buttons.map((b) => (
      <div class="net" data-for-net={b.id}>
        <button type="button" class="add" data-params={JSON.stringify(b.params)}>
          <b>{b.label}</b>
          <span>Chain ID {b.chainIdDec} · <span data-host>{b.rpcs[0].host}</span></span>
        </button>
        {b.rpcs.length > 1 && (
          <label class="pick"><span>{t.accessPoint}</span>
            <select data-rpc-pick>{b.rpcs.map((r) => <option value={r.url}>{r.provider} · {r.host}</option>)}</select>
          </label>
        )}
      </div>
    ))}
  </div>
  <p class="msg" role="status" data-msg></p>
  <p class="w-note">{t.addNote}</p>
</div>

<style>
  .btns { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
  .add { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; min-height: 64px; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--acc); background: color-mix(in srgb, var(--acc) 10%, transparent); color: #fff; font: inherit; text-align: left; cursor: pointer; transition: background .2s; }
  .add:hover { background: color-mix(in srgb, var(--acc) 20%, transparent); }
  .add b { font-size: 15.5px; font-weight: 600; }
  .add span { font-family: var(--mono); font-size: 11.5px; color: var(--w-dim); }
  .net { display: flex; flex-direction: column; gap: 8px; }
  .pick { display: flex; flex-direction: column; gap: 4px; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--w-dim); }
  .pick select { min-height: 36px; padding: 0 10px; border: 1px solid var(--w-rule); border-radius: 10px; background: transparent; color: var(--w-fg); font: inherit; font-size: 12.5px; letter-spacing: 0; text-transform: none; }
  .msg { margin: 12px 0 0; min-height: 1.6em; font-size: 14px; color: var(--w-fg); }
  .msg.bad { color: #F07A62; }
</style>

<script>
  type Eip1193 = { request: (a: { method: string; params?: unknown[] }) => Promise<unknown> };
  document.querySelectorAll<HTMLElement>('[data-addnet]').forEach((root) => {
    const msg = root.querySelector<HTMLElement>('[data-msg]')!;
    const t = JSON.parse(root.dataset.i18n!) as Record<'noWallet' | 'added' | 'cancelled' | 'failed', string>;
    const say = (text: string, bad = false) => { msg.textContent = text; msg.classList.toggle('bad', bad); };
    root.querySelectorAll<HTMLSelectElement>('[data-rpc-pick]').forEach((sel) => sel.addEventListener('change', () => {
      const host = sel.closest('.net')?.querySelector('[data-host]');
      if (host) host.textContent = sel.value.replace(/^https?:\/\//, '');
    }));
    root.querySelectorAll<HTMLButtonElement>('button[data-params]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const eth = (window as unknown as { ethereum?: Eip1193 }).ethereum;
        if (!eth) { say(t.noWallet, true); return; }
        const params = JSON.parse(btn.dataset.params!);
        // The access point picked next to the button, if any (the first one otherwise).
        const pick = btn.parentElement?.querySelector<HTMLSelectElement>('[data-rpc-pick]');
        if (pick) params.rpcUrls = [pick.value];
        try {
          await eth.request({ method: 'wallet_addEthereumChain', params: [params] });
          say(t.added.replace('{name}', params.chainName));
        } catch (e) {
          const code = (e as { code?: number }).code;
          say(code === 4001 ? t.cancelled : t.failed, true);
        }
      });
    });
  });
</script>
