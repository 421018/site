---
// Public provider directory (providers.yaml), grouped by service (services.yaml)
// and filtered by the network chosen with <NetworkSwitch />. Endpoints get a copy
// button; explorers and faucets, which are web pages, get a link.
import { getDirectory, pick } from '../directory';
import { langOf } from '../../kit/i18n';
import { fill, ui } from '../../kit/dictionary';
const lang = langOf(Astro);
const t = ui(lang).network;
const i18n = JSON.stringify({ copy: t.copy, copied: t.copied, manual: t.copyManual });
const { networks, services, providers } = await getDirectory();
const isPage = (service: string) => service === 'explorer' || service === 'faucet';
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
{services.map((s) => (
  <section class="svc" aria-labelledby={s.anchor} data-i18n={i18n}>
    <h3 id={s.anchor}>{pick(s.label, lang)}</h3>
    <p class="svc-d">{pick(s.description, lang)}</p>
    {networks.map((n) => {
      const rows = providers.filter((p) => p.service === s.id && p.network === n.id);
      return (
        <div data-for-net={n.id}>
          <p class="net-cap">{pick(n.label, lang)}</p>
          {rows.length ? (
            <ul class="rows">
              {rows.map((p) => (
                <li>
                  <span class="who">{p.provider}</span>
                  {isPage(s.id)
                    ? <a class="url" href={p.url}>{host(p.url)} ↗</a>
                    : <><code class="url">{p.url}</code><button type="button" class="cp" data-copy={p.url} aria-label={fill(t.copyLabel, { url: p.url })}>{t.copy}</button></>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="none">{s.emptyNote ? pick(s.emptyNote, lang) : fill(t.noProviders, { network: pick(n.label, lang).toLowerCase() })}</p>
          )}
        </div>
      );
    })}
  </section>
))}

<style>
  .svc { margin: 0 0 28px; }
  .svc h3 { margin-bottom: 4px; }
  .svc-d { margin: 0 0 10px; color: var(--muted); font-size: 15px; }
  .net-cap { margin: 12px 0 6px; font-family: var(--mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--link); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .rows li { display: grid; grid-template-columns: minmax(0, 180px) minmax(0, 1fr) auto; gap: 12px; align-items: center; margin: 0; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .who { font-weight: 600; color: var(--head); font-size: 15px; }
  .url { overflow-wrap: anywhere; font-size: 13.5px; }
  a.url { grid-column: 2 / 4; }
  .cp { min-height: 36px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--rule2); background: var(--bg); color: var(--ink); font: inherit; font-size: 13px; cursor: pointer; }
  .cp:hover { border-color: var(--link); color: var(--link); }
  .cp.ok { border-color: var(--link); color: var(--link); }
  .none { margin: 0; padding: 10px 0; color: var(--muted); font-size: 14.5px; border-top: 1px solid var(--rule); }
  @media (max-width: 560px) {
    .rows li { grid-template-columns: minmax(0, 1fr) auto; }
    .who { grid-column: 1 / -1; }
    a.url { grid-column: 1 / -1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((b) => {
    const t = JSON.parse(b.closest<HTMLElement>('[data-i18n]')!.dataset.i18n!) as { copy: string; copied: string; manual: string };
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = t.copied;
        b.classList.add('ok');
        setTimeout(() => { b.textContent = t.copy; b.classList.remove('ok'); }, 1600);
      } catch {
        b.textContent = t.manual;
      }
    });
  });
</script>
