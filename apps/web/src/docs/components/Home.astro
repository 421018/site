---
/**
 * Home page of the documentation, the developers' home (the site's Developers
 * button leads here): title and search beside the main network, live (figures
 * and the latest blocks); routes by goal; the console and its screens; one card per section
 * (label and summary of its index.md); the layers of the protocol and quick
 * data; and the map of every page.
 */
import { getEntry } from 'astro:content';
import Base from '../../kit/layouts/Base.astro';
import Footer from '../../site/components/Footer.astro';
import { getMenu, homeAlternates, hrefOf } from '../../kit/site';
import { langOf, resolveHref, withLang } from '../../kit/i18n';
import { consoleIcons, areaIcons } from '../../art/areas';
import { getConsoleText, SCREENS } from '../../console/text';
import { ui } from '../../kit/dictionary';
import { getDirectory, firstOf, pick } from '../../network/directory';
import DocsHeader from './DocsHeader.astro';
import Icon from '../../art/Icon.astro';

const lang = langOf(Astro);
const entry = await getEntry('docsHome', lang);
if (!entry) throw new Error(`Missing docs/${lang}/home.md in the content catalog`);
const { eyebrow, title, lead, searchPrompt, layers, quickData, live, starts, console: consoleBlock, map } = entry.data;
// The console's screens, named and described by the console's own texts.
const ct = await getConsoleText(lang);
const screens = SCREENS.filter((s) => s.id !== 'overview').map((s) => ({ id: s.id, href: withLang(`/${s.path}`, lang, 'console'), label: ct.nav[s.id], text: ct.overview.cards[s.id] }));
const svg = (d: string, size: number) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const menu = await getMenu(lang, 'docs');
const { networks, services, providers } = await getDirectory();
const net = networks[0];
const evm = firstOf(providers, net.id, 'evm');
const t = ui(lang).network;
const evmLabel = pick(services.find((s) => s.id === 'evm')!.label, lang);
const tones = ['mint', 'blue', 'amber', 'stone'];
const rpcs = providers.filter((p) => p.network === net.id && p.service === 'evm').map((p) => p.url);
const liveText = { seconds: live.seconds, block: live.block, unavailable: live.unavailable };
const go = (href: string) => resolveHref(href, lang, 'docs');
const sectionIcons: Record<string, string> = { 'get-started': 'connect', protocol: 'consensus', build: 'build', integrate: 'integrate', operate: 'node', 'open-source': 'opensource' };
---
<Base alternates={homeAlternates('docs')} product="docs">
  <DocsHeader alternates={homeAlternates('docs')} />
  <div class="dhome">
    <section class="dh-hero">
      <div class="dh-copy">
        <p class="dh-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="dh-lead">{lead}</p>
        <button type="button" class="sprompt" data-search-open>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.6"></path></svg>
          <span>{searchPrompt}</span><kbd>/</kbd>
        </button>
      </div>
      <aside class="dlive" data-docs-live data-chain={net.evmChainId} data-rpcs={JSON.stringify(rpcs)} data-i18n={JSON.stringify(liveText)}>
        <p class="dlive-k"><span class="live-dot" aria-hidden="true"></span>{live.label}<code>{net.chainId}</code></p>
        <div class="dlive-stream" aria-hidden="true"><ol class="lb-blocks" data-blocks></ol></div>
        <dl class="dlive-stats">
          <div><dt>{live.height}</dt><dd data-v="height">—</dd></div>
          <div><dt>{live.pace}</dt><dd data-v="pace">—</dd></div>
          <div><dt>{live.online}</dt><dd data-v="online">—</dd></div>
        </dl>
        <p class="dlive-state" data-state aria-live="polite"></p>
        <a class="dlive-link" href={go(live.link.href)}>{live.link.label} →</a>
      </aside>
    </section>

    <section class="dstarts" aria-labelledby="starts-t">
      <h2 id="starts-t" class="dsec">{starts.title}</h2>
      {starts.lead && <p class="dsec-lead">{starts.lead}</p>}
      <ul class="dstart-grid">
        {starts.items.map((r) => (
          <li class="dstart spot">
            <span class="dstart-ic"><Icon name={r.icon} size={24} /></span>
            <b>{r.title}</b>
            <ol class="dstart-steps">
              {r.steps.map((st, i) => <li><a href={go(st.href)}><span class="n">{String(i + 1).padStart(2, '0')}</span>{st.label}</a></li>)}
            </ol>
          </li>
        ))}
      </ul>
    </section>

    {consoleBlock && (
      <section class="dconsole" aria-labelledby="console-t">
        <div class="dconsole-intro">
          <p class="dconsole-k"><Fragment set:html={svg(areaIcons.console, 16)} />{consoleBlock.kicker}</p>
          <h2 id="console-t" class="dsec">{consoleBlock.title}</h2>
          <p class="dsec-lead">{consoleBlock.lead}</p>
          <a class="dconsole-open" href={withLang('/', lang, 'console')}>{consoleBlock.open} <span aria-hidden="true">→</span></a>
        </div>
        <ul class="dconsole-list">
          {screens.map((x) => (
            <li><a href={x.href}><span class="dconsole-ic"><Fragment set:html={svg(consoleIcons[x.id], 20)} /></span><span><b>{x.label}</b><span>{x.text}</span></span></a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="dcards" aria-label={map.title}>
      {menu.map((s) => (
        <a class="dcard spot" href={s.href}>
          <span class="dcard-ic"><Icon name={(sectionIcons[s.key] ?? 'docs') as never} size={26} /></span>
          <b>{s.label}</b>
          <span>{s.pages[0]?.data.summary}</span>
          <span class="dcard-go" aria-hidden="true">→</span>
        </a>
      ))}
    </section>

    <section class="dmore">
      {layers && (
        <div class="dlayers">
          <p class="dk">{layers.title}</p>
          {layers.items.map((l, i) => {
            const inner = <><span><b>{l.label}</b> <span>· {l.text}</span></span><span class="tag">{l.tag}</span></>;
            return l.href ? <a class:list={['layer', tones[i % tones.length]]} href={go(l.href)}>{inner}</a> : <div class:list={['layer', tones[i % tones.length]]}>{inner}</div>;
          })}
        </div>
      )}
      <div class="dquick">
        <p class="dk">{pick(net.label, lang)}{quickData && ` · ${quickData}`}</p>
        <dl>
          <dt>{t.evmChainId}</dt><dd><code>{net.evmChainId}</code></dd>
          <dt>{t.nativeChainId}</dt><dd><code>{net.chainId}</code></dd>
          {evm && <><dt>{evmLabel}</dt><dd><code>{evm.url.replace(/^https?:\/\//, '')}</code></dd></>}
        </dl>
      </div>
    </section>

    <section class="dmap" aria-labelledby="map-t">
      <h2 id="map-t" class="dsec">{map.title}</h2>
      {map.lead && <p class="dsec-lead">{map.lead}</p>}
      <div class="dmap-grid">
        {menu.map((s) => (
          <div class="dmap-col">
            <a class="dmap-h" href={s.href}>{s.label}</a>
            <ul>{s.pages.slice(1).map((p) => <li><a href={hrefOf(p)}>{p.data.title}</a>{p.data.summary && <span>{p.data.summary}</span>}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  </div>
  <Footer alternates={homeAlternates('docs')} />
</Base>

<script>
  import { mountStream } from '../../network/live';
  document.querySelectorAll<HTMLElement>('[data-docs-live]').forEach((root) => {
    mountStream(root, { urls: JSON.parse(root.dataset.rpcs!), chain: Number(root.dataset.chain), t: JSON.parse(root.dataset.i18n!), keep: 9, seed: 9 });
  });
</script>

<style>
  .dhome { max-width: 1360px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px) 96px; color: var(--ink); }
  .dh-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 40px 56px; align-items: center; padding: 64px 0 40px; }
  .dh-eyebrow { margin: 0 0 14px; font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--link); }
  .dh-copy h1 { margin: 0; max-width: 760px; font-size: clamp(34px, 4.4vw, 52px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 500; color: var(--head); animation: fadeUp 1s cubic-bezier(.16,1,.3,1) backwards; }
  .dh-lead { margin: 18px 0 0; max-width: 620px; font-size: 17.5px; line-height: 1.6; color: var(--muted); }
  .sprompt { margin-top: 28px; display: flex; align-items: center; gap: 12px; min-height: 54px; width: min(560px, 100%); padding: 0 16px; border: 1px solid var(--rule2); border-radius: 14px; background: var(--surface); color: var(--muted); font: inherit; font-size: 15px; text-align: left; cursor: pointer; transition: border-color .25s, box-shadow .25s; }
  .sprompt:hover { border-color: var(--link); box-shadow: 0 0 0 4px color-mix(in srgb, var(--link) 12%, transparent); }
  .sprompt span { flex: 1; }
  .sprompt kbd { font-family: var(--mono); font-size: 12px; padding: 2px 8px; border: 1px solid var(--rule2); border-radius: 6px; }

  /* the network, live: always on the night, in both themes */
  .dlive { --stream-n: #6B7785; position: relative; overflow: hidden; padding: 22px 22px 18px; border-radius: 20px; border: 1px solid #1C2530; background: radial-gradient(420px 220px at 90% 0%, rgba(91,240,200,.10), transparent 70%), #070A10; color: #C3CBD3; box-shadow: 0 30px 60px -30px rgba(0,0,0,.45); }
  .dlive-k { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 13.5px; font-weight: 500; color: #F1F4F7; }
  .dlive-k code { margin-left: auto; font-family: var(--mono); font-size: 11.5px; font-weight: 400; color: #8C97A4; }
  .dlive-stream { margin: 18px -4px 0; padding: 6px 0; -webkit-mask: linear-gradient(90deg, transparent, #000 25%); mask: linear-gradient(90deg, transparent, #000 25%); }
  .dlive-stream .lb-blocks { min-height: 64px; gap: 10px; }
  .dlive-stream .lb-sq { width: 30px; height: 30px; border-radius: 8px; }
  .dlive-stream .lb-b + .lb-b::before { top: 15px; width: 12px; }
  .dlive-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 14px 0 0; padding-top: 16px; border-top: 1px solid #1A222C; }
  .dlive-stats dt { font-size: 12px; color: #8C97A4; }
  .dlive-stats dd { margin: 6px 0 0; font-family: var(--mono); font-size: clamp(17px, 1.6vw, 21px); color: #F1F4F7; font-variant-numeric: tabular-nums; }
  .dlive-state { margin: 10px 0 0; font-family: var(--mono); font-size: 12px; color: #8C97A4; }
  .dlive-state:empty { display: none; }
  .dlive-link { display: inline-block; margin-top: 14px; font-size: 13.5px; color: #5BF0C8; text-decoration: none; }
  .dlive-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .dsec { margin: 0; font-size: clamp(22px, 2.2vw, 28px); font-weight: 600; letter-spacing: -0.025em; color: var(--head); }
  .dsec-lead { margin: 8px 0 0; color: var(--muted); font-size: 15.5px; }
  .dstarts { padding: 40px 0 8px; }
  .dstart-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 24px 0 0; padding: 0; list-style: none; }
  .dstart { display: flex; flex-direction: column; gap: 12px; padding: 20px 20px 16px; border: 1px solid var(--rule); border-radius: 16px; background: var(--surface); transition: border-color .2s, transform .25s cubic-bezier(.16,1,.3,1); }
  .dstart:hover { border-color: color-mix(in srgb, var(--link) 35%, var(--rule)); transform: translateY(-3px); }
  .dstart-ic { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 12px; background: color-mix(in srgb, var(--link) 12%, transparent); color: var(--link); }
  .dstart b { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; color: var(--head); }
  .dstart-steps { display: flex; flex-direction: column; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .dstart-steps a { display: flex; align-items: center; gap: 10px; min-height: 36px; padding: 0 8px; margin: 0 -8px; border-radius: 8px; color: var(--ink); text-decoration: none; font-size: 14.5px; }
  .dstart-steps a:hover { background: var(--soft); color: var(--head); }
  .dstart-steps .n { font-family: var(--mono); font-size: 11.5px; color: var(--link); }

  .dcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; padding: 40px 0 24px; }
  .dcard { display: flex; flex-direction: column; gap: 10px; min-height: 190px; padding: 24px; border-radius: 18px; background: var(--surface); border: 1px solid var(--rule); color: var(--ink); text-decoration: none; transition: border-color .2s, transform .25s cubic-bezier(.16,1,.3,1); }
  .dcard:hover { border-color: color-mix(in srgb, var(--link) 35%, var(--rule)); transform: translateY(-4px); }
  .dcard-ic { color: var(--link); margin-bottom: 6px; transition: transform .25s cubic-bezier(.16,1,.3,1); }
  .dcard:hover .dcard-ic { transform: rotate(-8deg) scale(1.08); }
  .dcard b { font-size: 21px; font-weight: 600; letter-spacing: -0.02em; color: var(--head); }
  .dcard span { font-size: 14.5px; line-height: 1.55; color: var(--muted); }
  .dcard .dcard-go { margin-top: auto; color: var(--link); transition: transform .2s cubic-bezier(.16,1,.3,1); }
  .dcard:hover .dcard-go { transform: translateX(6px); }

  .dmore { display: flex; flex-wrap: wrap; gap: 32px; padding-top: 24px; }
  .dlayers { flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .dquick { flex: 1 1 340px; min-width: 0; align-self: flex-start; padding: 22px; border-radius: 16px; background: var(--surface); border: 1px solid var(--rule); }
  .dk { margin: 0 0 12px; font-family: var(--mono); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .layer { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; border-radius: 12px; border: 1px solid var(--rule); color: var(--head); text-decoration: none; font-size: 15.5px; }
  .layer b { font-weight: 500; }
  .layer > span > span { color: var(--muted); }
  .layer .tag { font-family: var(--mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; }
  .layer.mint { background: color-mix(in srgb, #5BF0C8 12%, var(--surface)); }
  .layer.blue { background: color-mix(in srgb, #7C9CFF 12%, var(--surface)); }
  .layer.amber { background: color-mix(in srgb, #F2C879 14%, var(--surface)); }
  .layer.stone { background: var(--soft); }
  a.layer:hover { border-color: var(--link); }
  .dquick dl { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 16px; font-size: 14px; }
  .dquick dt { color: var(--muted); }
  .dquick dd { margin: 0; overflow-wrap: anywhere; }
  .dquick code { font-family: var(--mono); color: var(--head); }

  .dmap { margin-top: 72px; padding-top: 48px; border-top: 1px solid var(--rule); }
  .dmap-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 48px; margin-top: 32px; }
  .dmap-h { display: inline-block; margin-bottom: 12px; font-weight: 600; font-size: 16px; color: var(--head); text-decoration: none; }
  .dmap-h:hover { color: var(--link); }
  .dmap ul { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .dmap li a { color: var(--link); text-decoration: none; font-size: 14.5px; }
  .dmap li a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .dmap li span { display: block; margin-top: 2px; font-size: 13.5px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 1000px) { .dh-hero { grid-template-columns: 1fr; } .dstart-grid, .dcards, .dmap-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .dstart-grid, .dcards, .dmap-grid { grid-template-columns: 1fr; } .dh-hero { padding-top: 40px; } }
  /* the console, part of the developers' home */
  .dconsole { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 32px 48px; align-items: center; margin: 56px 0 0; padding: clamp(24px, 3vw, 36px); border: 1px solid var(--rule); border-radius: 20px; background: var(--surface); }
  .dconsole-k { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 12px; font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--link); }
  .dconsole-open { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; margin-top: 22px; padding: 0 18px; border: 1px solid var(--rule2); border-radius: 999px; color: var(--head); text-decoration: none; font-size: 14.5px; font-weight: 500; transition: border-color .2s, background .2s; }
  .dconsole-open:hover { border-color: var(--link); background: color-mix(in srgb, var(--link) 7%, transparent); }
  .dconsole-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .dconsole-list a { display: flex; gap: 14px; height: 100%; box-sizing: border-box; padding: 16px; border: 1px solid var(--rule); border-radius: 14px; color: var(--ink); text-decoration: none; transition: border-color .2s, background .2s; }
  .dconsole-list a:hover { border-color: color-mix(in srgb, var(--link) 40%, var(--rule)); background: var(--soft); }
  .dconsole-ic { flex: none; color: var(--link); margin-top: 1px; }
  .dconsole-list b { display: block; color: var(--head); font-size: 15px; font-weight: 600; }
  .dconsole-list span span { display: block; margin-top: 4px; font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 1000px) { .dconsole { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .dconsole-list { grid-template-columns: 1fr; } }
</style>
