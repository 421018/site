---
/**
 * Header of the documentation: the bar it shares with the console
 * (kit/components/Header.astro) with what is the documentation's own: the
 * search box, the theme button, the sections as tabs and the notice. There is
 * no network switch here: a page whose values differ per network shows each one
 * under its label, or carries its own switch where those values are (the
 * network-switch widget).
 */
import Header from '../../kit/components/Header.astro';
import Search from '../../kit/components/Search.astro';
import { getSiteText } from '../../kit/site';
import { langOf } from '../../kit/i18n';
interface Props { current?: string; alternates?: Record<string, string> }
const { current, alternates = {} } = Astro.props;
const text = await getSiteText(langOf(Astro), 'docs');
---
<Header current={current} alternates={alternates}>
  {text.header.search && <Search slot="search" text={text.header.search} />}
  <Fragment slot="controls">
    {text.header.themeDark && <button type="button" class="hicon" data-theme-toggle data-dark={text.header.themeDark} data-light={text.header.themeLight} aria-label={text.header.themeDark}><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 9.5 A5.5 5.5 0 1 1 6.5 3 A4.5 4.5 0 0 0 13 9.5 Z" /></svg></button>}
  </Fragment>
  {text.header.notice && (
    <div slot="below" class="hnotice" role="note">
      <div class="hnotice-in">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L22 20 H2 Z" /><path d="M12 10 V14 M12 17.5 V17.6" /></svg>
        <p><b>{text.header.notice.label}</b> <span>{text.header.notice.text}</span></p>
        <button type="button" class="hnotice-x" data-notice-close aria-label={text.header.notice.close ?? '×'}><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 3 L11 11 M11 3 L3 11" stroke="currentColor" stroke-width="1.6" /></svg></button>
      </div>
    </div>
  )}
</Header>

<script>
  // Theme: the system's (light or dark) until the reader picks one; the choice is remembered
  // when storage is available. Base.astro applies it before the first paint.
  const KEY = '42docs-theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const apply = (dark: boolean) => {
    if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
    if (button) button.setAttribute('aria-label', (dark ? button.dataset.light : button.dataset.dark) ?? '');
  };
  let saved: string | null = null;
  try { saved = localStorage.getItem(KEY); } catch { /* storage unavailable */ }
  apply(saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
  document.querySelector('[data-notice-close]')?.addEventListener('click', () => {
    root.dataset.notice = 'off';
    try { localStorage.setItem('42docs-notice', 'off'); } catch { /* hidden for this page only */ }
  });
  button?.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    apply(dark);
    try { localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch { /* keep it for this page */ }
  });
</script>
