---
/**
 * Header of the documentation, a product of its own: brand, search, network
 * switch (shared with the network widgets on the page), theme, language and
 * links; below, one tab per section.
 */
import Search from '../../kit/components/Search.astro';
import LangMenu from '../../kit/components/LangMenu.astro';
import { areaIcons } from '../../art/areas';
import NetworkSwitch from '../../network/components/NetworkSwitch.astro';
import { getMenu, getSiteText } from '../../kit/site';
import { homeHref, isLinkAvailable, langOf, resolveHref } from '../../kit/i18n';
interface Props { current?: string; alternates?: Record<string, string> }
const { current, alternates = {} } = Astro.props;
const lang = langOf(Astro);
const menu = await getMenu(lang, 'docs');
const text = await getSiteText(lang, 'docs');
// Links to the site or the console change the whole view: buttons with an icon, like the
// site's "Documentation" button. Back to the site: an arrow.
const links = text.header.links.filter((l) => isLinkAvailable(l.href)).map((l) => ({ label: l.label, href: resolveHref(l.href, lang, 'docs'), to: l.href.match(/^(site|console):/)?.[1] }));
---
<header class="dh">
  <div class="dh-top">
    <a class="dh-brand" href={homeHref(lang, 'docs')} aria-label={text.header.homeLink}><span class="dh-mark">42</span>{text.header.brand && <span>{text.header.brand}</span>}</a>
    {text.header.search && <div class="dh-search"><Search text={text.header.search} /></div>}
    <div class="dh-tools">
      <div class="dh-net"><NetworkSwitch /></div>
      {text.header.themeDark && <button type="button" class="dh-theme" data-theme-toggle data-dark={text.header.themeDark} data-light={text.header.themeLight} aria-label={text.header.themeDark}><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 9.5 A5.5 5.5 0 1 1 6.5 3 A4.5 4.5 0 0 0 13 9.5 Z" /></svg></button>}
      <LangMenu alternates={alternates} />
      {links.map((l) => l.to ? (
        <a class:list={['htool', `to-${l.to}`]} href={l.href} aria-label={l.label}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={areaIcons[l.to as 'site' | 'console']} />
          <span>{l.label}</span>
        </a>
      ) : <a class="dh-link" href={l.href}>{l.label}</a>)}
    </div>
  </div>
  {text.header.notice && (
    <div class="dh-notice" role="note">
      <div class="dh-notice-in">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L22 20 H2 Z" /><path d="M12 10 V14 M12 17.5 V17.6" /></svg>
        <p><b>{text.header.notice.label}</b> {text.header.notice.text}</p>
      </div>
    </div>
  )}
  <nav class="dh-tabs" aria-label={text.header.mainNav}>
    {text.header.home && <a href={homeHref(lang, 'docs')} aria-current={!current && Astro.url.pathname.replace(/\/$/, '') === homeHref(lang, 'docs').replace(/\/$/, '') ? 'true' : undefined}>{text.header.home}</a>}
    {menu.map((s) => <a href={s.href} aria-current={current === s.key ? 'true' : undefined}>{s.label}</a>)}
  </nav>
</header>

<script>
  // Theme: the system's (light or dark) until the reader picks one; the choice is remembered
  // when storage is available. Base.astro applies it before the first paint.
  const KEY = '42docs-theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const apply = (dark: boolean) => {
    if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
    if (button) button.setAttribute('aria-label', (dark ? button.dataset.light : button.dataset.dark) ?? '');
  };
  let saved: string | null = null;
  try { saved = localStorage.getItem(KEY); } catch { /* storage unavailable */ }
  apply(saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
  button?.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    apply(dark);
    try { localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch { /* keep it for this page */ }
  });
</script>
