---
import { Font } from 'astro:assets';
import { areaOf, defaultLang, langOf, ogLocale } from '../i18n';
import { getSiteText } from '../site';
import Motion from '../components/Motion.astro';

interface Props {
  title?: string;
  description?: string;
  /** The same page in every language that has it, as { lang: href }: hreflang links. */
  alternates?: Record<string, string>;
  /** Product whose design applies (html data-product), e.g. "docs". */
  product?: string;
  /** Canonical URL when it is another page (a page shown untranslated points to its original). */
  canonicalHref?: string;
  /** Section colors (frontmatter `section.accent` / `section.ink`); the defaults live in the section's stylesheet (@42chain/ui). */
  accent?: string;
  ink?: string;
}
const lang = langOf(Astro);
const text = await getSiteText(lang, areaOf(Astro));
const { title, description = text.description, accent, ink, alternates = {}, product, canonicalHref } = Astro.props;
const others = Object.entries(alternates);
const colors = [accent && `--acc: ${accent}`, ink && `--link: ${ink}`].filter(Boolean).join('; ') || undefined;
const fullTitle = title ? `${title} — ${text.name}` : `${text.name} — ${text.tagline}`;
const canonical = new URL(canonicalHref ?? Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang} style={colors} data-product={product}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {others.length > 1 && others.map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />)}
    {others.length > 1 && alternates[defaultLang] && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={text.name} />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#05070A" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-geist" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-newsreader" />
  </head>
  <body id="top">
    <slot />
    <Motion />
  </body>
</html>
