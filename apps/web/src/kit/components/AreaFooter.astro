---
/**
 * The compact footer, shown by the documentation and the console. It is the
 * whole site's footer (content/site/<lang>/site.md → footer) in short form:
 * the area's mark with the copyright under it, the site's main destinations
 * (footer.compact; the current area marked) and the official profiles.
 * Styles: .pf in @42chain/ui/base.css, in each area's palette.
 */
import { getSiteText } from '../site';
import { areaOf, homeHref, langOf, resolveHref } from '../i18n';
import { socialIcons } from '../../art/areas';
const lang = langOf(Astro);
const area = areaOf(Astro);
const own = await getSiteText(lang, area);
const footer = (await getSiteText(lang, 'site')).footer!;
const links = footer.compact.map((l) => ({ label: l.label, href: resolveHref(l.href, lang, 'site'), here: l.href.startsWith(`${area}:`) }));
---
<footer class="pf">
  <div class="pf-in">
    <div class="pf-id">
      <a class="pf-brand" href={homeHref(lang, area)} aria-label={own.header.homeLink}><span class="mark">42</span>{own.header.brand}</a>
      <span class="pf-note">{footer.note}</span>
    </div>
    <nav class="pf-nav" aria-label={own.header.mainNav}>
      {links.map((l) => <a href={l.href} aria-current={l.here ? 'true' : undefined}>{l.label}</a>)}
    </nav>
    {footer.social.map((s) => (
      <a class="pf-social" href={s.href} rel="me" aria-label={`${s.label}: ${s.handle}`} title={s.handle}>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons[s.network]} />
      </a>
    ))}
  </div>
</footer>
