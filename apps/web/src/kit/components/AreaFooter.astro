---
/**
 * The compact footer of the documentation and the console: the same markup and
 * style in both, each in its own palette (light docs, dark console). Brand,
 * the area's links (footer.columns: the first is its own navigation, the
 * second the way home), the official profiles and the legal line.
 * Styles: .pf in @42chain/ui/base.css.
 */
import { getSiteText } from '../site';
import { areaOf, homeHref, isExternal, isLinkAvailable, langOf, resolveHref } from '../i18n';
import { socialIcons } from '../../art/areas';
const lang = langOf(Astro);
const area = areaOf(Astro);
const text = await getSiteText(lang, area);
type FLink = { label: string; href: string; text?: string };
const resolve = (links: FLink[]) => links.filter((l) => isLinkAvailable(l.href)).map((l) => ({ ...l, href: resolveHref(l.href, lang, area) }));
const [nav, family] = (text.footer.columns ?? []).map((c) => ({ label: c.label, links: resolve(c.links) }));
const baseLinks = resolve(text.footer.links);
---
<footer class="pf">
  <div class="pf-in">
    <a class="pf-brand" href={homeHref(lang, area)} aria-label={text.header.homeLink}><span class="mark">42</span>{text.header.brand}</a>
    {nav && <nav aria-label={nav.label}>{nav.links.map((l) => <a class:list={{ ext: isExternal(l.href) }} href={l.href}>{l.label}</a>)}</nav>}
    {family && family.links.map((l) => <a class="pf-fam" href={l.href}>{family.label}: <b>{l.label}</b>{l.text && <>, {l.text}</>}</a>)}
    {text.footer.social.map((s) => (
      <a class="pf-social" href={s.href} rel="me" aria-label={`${s.label}: ${s.handle}`} title={s.handle}>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons[s.network]} />
      </a>
    ))}
  </div>
  <div class="pf-base"><span>{baseLinks.map((l) => <><a class:list={{ ext: isExternal(l.href) }} href={l.href}>{l.label}</a> · </>)}{text.footer.license}</span><span>{text.footer.note}</span></div>
</footer>
