---
/**
 * The header of every page of every area (site, docs, console): the same bar,
 * brand, buttons, language menu and narrow-screen menu, so moving between areas
 * never changes the frame. Each area adds what is its own:
 * - the site: its main menu inline (starting with "home"), with section panels,
 *   and a button to each other area;
 * - the documentation and the console share one bar, element for element: the
 *   documentation's search box ("search" slot), the switch between the three
 *   areas (the current one marked) and the language, then their sections (the
 *   documentation's) or screens (the console's, given in `nav`) as tabs under it.
 *   Moving between the two never moves anything in the header.
 * Controls of an area (the documentation's theme) go in the "controls" slot, to
 * the left of the area switch so they never push it; a notice goes in the "below" slot.
 * On the site, a page with search passes it in the "search" slot (inside the menu).
 * Sections with `dropdown: true` open a panel with their
 * pages on hover, keyboard focus or a tap on their arrow; without JavaScript
 * the section link still leads to its index page. Header links with a
 * `weight` are placed among the sections.
 */
import Icon from '../../art/Icon.astro';
import LangMenu from './LangMenu.astro';
import { areaIcons as toolIcon } from '../../art/areas';
import { getMenu, getSiteText, menuPanel } from '../site';
import { blogHref, getBlog, hasBlogIndex } from '../blog';
import { areaOf, homeHref, isLinkAvailable, langOf, resolveHref } from '../i18n';
interface Props {
  current?: string;
  /** The current page in other languages ({ lang: href }); languages without it link to their home page. */
  alternates?: Record<string, string>;
  /** Marks a header link as current (e.g. the blog). */
  currentHref?: string;
  /** The console's screens: its tabs and its narrow-screen menu. */
  nav?: { label: string; href: string; on?: boolean }[];
}
const { current, alternates = {}, currentHref, nav } = Astro.props;
const lang = langOf(Astro);
const area = areaOf(Astro);
// The console has no Markdown sections: its screens come in `nav`.
const menu = area === 'console' ? [] : await getMenu(lang, area);
// Where the main menu goes: inline in the bar (site) or as tabs under it (docs, console).
const tabs = area !== 'site';
const text = await getSiteText(lang, area);
type Item =
  | { kind: 'section'; weight: number; key: string; label: string; href: string; panel?: ReturnType<typeof menuPanel> }
  | { kind: 'link'; weight: number; label: string; href: string };
// A header link to another area (docs:, site:) or product (console:) is not a menu item:
// it changes the whole view, so it is shown apart, as a button with its own icon.
const toOther = (href: string) => { const m = href.match(/^(site|docs|console):/); return m && m[1] !== area ? (m[1] as 'site' | 'docs' | 'console') : undefined; };
const links = text.header.links.filter((l) => isLinkAvailable(l.href));
const tools = links.filter((l) => toOther(l.href)).map((l) => ({ label: l.label, href: resolveHref(l.href, lang, area), to: toOther(l.href)! }));
const items: Item[] = [
  ...menu.map((s) => ({ kind: 'section' as const, weight: s.weight, key: s.key, label: s.label, href: s.href, panel: s.dropdown ? menuPanel(s) : undefined })),
  ...links.filter((l) => !toOther(l.href)).map((l) => ({ kind: 'link' as const, weight: l.weight ?? Infinity, label: l.label, href: resolveHref(l.href, lang, area) })),
].sort((a, b) => a.weight - b.weight);
// The blog link only appears once the blog index has posts of its own.
const blog = area === 'site' ? await getBlog(lang) : undefined;
if (blog && !(await hasBlogIndex(lang))) {
  const i = items.findIndex((x) => x.kind === 'link' && x.href === blogHref(blog, lang));
  if (i >= 0) items.splice(i, 1);
}
const home = homeHref(lang, area);
const atHome = Astro.url.pathname.replace(/\/$/, '') === home.replace(/\/$/, '');
const isOn = (i: Item) => (i.kind === 'section' && i.key === current) || (i.kind === 'link' && !!currentHref && i.href === currentHref);
const homeOn = atHome && !current;
// The documentation and the console: one switch between the three areas, always in the same
// order and size, the current one marked. Labels come from the site's and the docs' header links.
const siteText = await getSiteText(lang, 'site');
const docsText = await getSiteText(lang, 'docs');
const labelOf = (links: { label: string; href: string }[], to: string) => links.find((l) => l.href.startsWith(`${to}:`))?.label;
const areas = (['site', 'docs', 'console'] as const).map((to) => ({
  to,
  href: resolveHref(`${to}:/`, lang, area),
  label: (to === 'site' ? labelOf(docsText.header.links, 'site') : labelOf(siteText.header.links, to)) ?? to,
}));
// In a switch the site is a place, not a way back: a house instead of the back arrow.
const homeIcon = '<path d="M4 11 L12 4 L20 11" /><path d="M6.5 9.5 V20 H17.5 V9.5" />';
const tabItems = nav ?? [
  ...(text.header.home ? [{ label: text.header.home, href: home, on: homeOn }] : []),
  ...items.map((i) => ({ label: i.label, href: i.href, on: isOn(i) })),
];
---
<div class:list={['hbar', `hbar-${area}`]}>
<header class="site-header">
  <a class="brand" href={home} aria-label={text.header.homeLink}>
    <span class="mark">42</span>{text.header.brand && <span class="name">{text.header.brand}</span>}
  </a>
  {tabs && Astro.slots.has('search') && <div class="hsearch"><slot name="search" /></div>}
  {area === 'site' && <nav class="menu" aria-label={text.header.mainNav}>
    {text.header.home && <a class:list={['nl', { on: atHome }]} href={home} data-label={text.header.home} aria-current={atHome ? 'page' : undefined}>{text.header.home}</a>}
    {items.map((i, n) => i.kind === 'section' && i.panel ? (
      <div class="dd" data-dd>
        <a class:list={['nl', { on: isOn(i) }]} href={i.href} data-label={i.label} aria-current={isOn(i) ? 'true' : undefined}>{i.label}</a>
        <button type="button" class="dd-t" aria-expanded="false" aria-controls={`dd-${n}`} aria-label={text.header.submenu ? `${i.label}: ${text.header.submenu}` : i.label}>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 L5 6.5 L8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <div class="dd-panel" id={`dd-${n}`}>
          <div class="dd-grid">
            {i.panel.items.map((p) => (
              <a class="dd-item" href={p.href}>
                {p.icon && <Icon name={p.icon} size={26} class="dd-ic" />}
                <span><b>{p.label}</b>{p.text && <span>{p.text}</span>}</span>
              </a>
            ))}
          </div>
          <a class="dd-feat stars" href={i.panel.featured.href}>
            <b>{i.panel.featured.label}</b>
            <span>{i.panel.featured.text}</span>
          </a>
        </div>
      </div>
    ) : (
      <a class:list={['nl', { on: isOn(i) }]} href={i.href} data-label={i.label} aria-current={isOn(i) ? 'true' : undefined}>{i.label}</a>
    ))}
    <slot name="search" />
  </nav>}
  <div class="hside">
    <slot name="controls" />
    {tabs && (
      <nav class="harea" aria-label={text.header.areasNav ?? text.header.mainNav}>
        {areas.map((a) => (
          <a class:list={['harea-i', { on: a.to === area }]} href={a.href} aria-current={a.to === area ? 'true' : undefined}>
            <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={a.to === 'site' ? homeIcon : toolIcon[a.to]} />
            <span>{a.label}</span>
          </a>
        ))}
      </nav>
    )}
    {!tabs && tools.map((t) => (
      <a class:list={['htool', `to-${t.to}`]} href={t.href}>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={toolIcon[t.to]} />
        <span>{t.label}</span>
      </a>
    ))}
    {text.header.cta && <a class="hcta" href={resolveHref(text.header.cta.href, lang, area)}>{text.header.cta.label}</a>}
    <LangMenu alternates={alternates} />
    {/* Narrow screens: the same links behind a disclosure (no script, CSP-safe). */}
    <details class="menu-m">
      <summary class="nl">{text.header.menuButton}</summary>
      <nav aria-label={text.header.mainNav}>
        {nav ? nav.map((n) => <a class:list={['ml', { on: n.on }]} href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>) : text.header.home && <a class:list={['ml', { on: homeOn }]} href={home} aria-current={homeOn ? 'page' : undefined}>{text.header.home}</a>}
        {items.map((i) => (
          <>
            <a class:list={['ml', { on: isOn(i) }]} href={i.href} aria-current={isOn(i) ? 'true' : undefined}>{i.label}</a>
            {i.kind === 'section' && i.panel && i.panel.items.map((p) => <a class="ml sub" href={p.href}>{p.label}</a>)}
          </>
        ))}
        {area === 'site' && Astro.slots.has('search') && text.header.search && <button type="button" class="ml" data-search-open>{text.header.search.label}</button>}
        {tools.length > 0 && <div class="ml-sep" role="presentation" />}
        {tools.map((t) => (
          <a class="ml tool" href={t.href}>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={toolIcon[t.to]} />
            {t.label}
          </a>
        ))}
        {text.header.cta && <a class="ml cta" href={resolveHref(text.header.cta.href, lang, area)}>{text.header.cta.label}</a>}
      </nav>
    </details>
  </div>
</header>
{tabs && (
  <nav class="htabs" aria-label={text.header.mainNav}>
    {tabItems.map((i) => <a class:list={['nl', { on: i.on }]} href={i.href} data-label={i.label} aria-current={i.on ? 'page' : undefined}>{i.label}</a>)}
  </nav>
)}
<slot name="below" />
</div>

<script>
  // Section panels: the arrow button opens and closes them (touch, keyboard);
  // hover and focus open them with CSS. Escape or a click elsewhere closes.
  const dds = [...document.querySelectorAll<HTMLElement>('[data-dd]')];
  const close = (except?: HTMLElement) => dds.forEach((d) => {
    if (d === except) return;
    d.classList.remove('open');
    d.querySelector('.dd-t')?.setAttribute('aria-expanded', 'false');
  });
  dds.forEach((d) => {
    const t = d.querySelector<HTMLButtonElement>('.dd-t')!;
    t.addEventListener('click', () => {
      const open = !d.classList.contains('open');
      close(d);
      d.classList.toggle('open', open);
      t.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-dd]')) close(); });
</script>
