---
import Base from '../../kit/layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Header from '../../kit/components/Header.astro';
import Footer from '../components/Footer.astro';
import SideNav from '../../kit/components/SideNav.astro';
import { getAlternates, getSection, getSiteText, sideIndex, prevNext, hrefOf, pageLang, pagePath, sectionKey, menuLabel, type Page } from '../../kit/site';
import { homeHref, sourceLang, withLang } from '../../kit/i18n';
import kit from 'virtual:42chain/kit';
import { catalogRelative } from '../../kit/catalog';

interface Props { page: Page; headings?: { depth: number; slug: string; text: string }[] }
const { page, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const lang = pageLang(page);
const section = await getSection(lang, sectionKey(page));
const home = await getSection(lang, section.home);
const alternates = await getAlternates(page);
const nav = sideIndex(home);
const showSide = nav.items.length + nav.refs.length > 1;
const path = hrefOf(page);
const { prev, next } = prevNext(section, page);
// Site pages show a date only when they set one on purpose (`updated`, e.g. the legal page): their
// texts are stable, and a typo fix must not look like a new version. Docs pages use their file's last commit.
const updated = page.data.updated;
const fmt = updated && new Intl.DateTimeFormat(lang, { dateStyle: 'long', timeZone: 'UTC' }).format(updated) // UTC: the same day locally and in the (UTC) production build;
const { page: ui, header } = await getSiteText(lang);
const docsUi = (await getSiteText(lang, 'docs')).page;
const onThisPage = docsUi.onThisPage;
// Not translated yet: the source-language text, with a notice; search engines are pointed to the original.
const original = page.fallbackOf;
const canonicalHref = original ? withLang('/' + pagePath(page), sourceLang) : undefined;
// Breadcrumbs: home › section › group (for pages inside a group); the page itself is the title below.
const parts = page.id.split('/').slice(1);
const group = parts.length === 3 ? section.pages.find((p) => p.id === page.id.split('/').slice(0, 3).join('/')) : undefined;
const crumbs = [
  ...(header.home ? [{ href: homeHref(lang), label: header.home }] : []),
  ...(parts.length > 1 ? [{ href: section.href, label: section.label }] : [{ href: '', label: section.label }]),
  ...(group ? [{ href: hrefOf(group), label: menuLabel(group) }] : []),
];
---
<Base title={page.data.title} description={page.data.summary} accent={section.accent} ink={section.ink} alternates={alternates} canonicalHref={canonicalHref}>
  <Header current={home.key} alternates={alternates} />
  <Cover crumbs={crumbs} crumbsLabel={header.mainNav} title={page.data.title} titleLang={original ? sourceLang : undefined}>
    {fmt && <span>{ui.lastUpdated}: {fmt}</span>}
    {kit.editBase && <a href={kit.editBase + catalogRelative(page.filePath!)}>{ui.editPage}</a>}
  </Cover>
  <div class:list={['rd', 'covered', { solo: !showSide }]}>
    <div class="lay">
      {showSide && <SideNav nav={nav} path={path} />}
      <main lang={original ? sourceLang : undefined} data-page={pagePath(page)}>
        {original && ui.untranslated && <p class="untranslated" lang={lang}>{ui.untranslated}</p>}
        <div class="prose">
          <slot />
        </div>
        {(prev || next) && (
          <nav class="pn" aria-label={ui.chapters}>
            {prev && <a class="pv" href={prev.href}><span>{ui.previous}</span>{prev.label}</a>}
            {next && <a class="nx" href={next.href}><span>{ui.next}</span>{next.label}</a>}
          </nav>
        )}
      </main>
      {onThisPage && toc.length > 2 && (
        <aside class="rtoc">
          <p>{onThisPage}</p>
          <nav aria-label={onThisPage} data-toc>{toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
        </aside>
      )}
    </div>
  </div>
  <Footer alternates={alternates} />
</Base>
