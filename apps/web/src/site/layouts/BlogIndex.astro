---
/**
 * The blog index of a language: title band, the featured post (the newest
 * with featured: true, else the newest), category filters and the other posts.
 * Filters need JavaScript; without it every post is listed. A #<category>
 * in the URL preselects that category.
 */
import { Image } from 'astro:assets';
import Base from '../../kit/layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Header from '../../kit/components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../../kit/components/PostCard.astro';
import { blogHref, categoryOf, categoryTint, getBlog, getBlogPosts, postHref, postDate, readingMinutes } from '../../kit/blog';
import { languages } from '../../kit/i18n';
interface Props { lang: string }
const { lang } = Astro.props;
const blog = (await getBlog(lang))!;
const posts = await getBlogPosts(lang);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const fcat = categoryOf(blog, featured);
const used = blog.categories.filter((c) => posts.some((p) => p.data.category === c.id));
const date = (d: Date | undefined) => d && new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(d);
const fdate = date(postDate(featured));
const alternates = Object.fromEntries(await Promise.all(languages.map(async (l) => [l, blogHref((await getBlog(l))!, l)])));
---
<Base title={blog.kicker} description={blog.lead} alternates={alternates}>
  <Header currentHref={blogHref(blog, lang)} alternates={alternates} />
  <Cover kicker={blog.kicker} title={blog.title} />
  <div class="rd blog-rd covered">
    <div class="blog-in">
      <a class="feat" href={postHref(blog, featured)}>
        {featured.data.image && <figure class="duo feat-img" style={`--tint: ${categoryTint(blog, fcat.id)}`}><Image src={featured.data.image as never} alt={featured.data.alt!} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 55vw" /></figure>}
        <span class="feat-body">
          <span class="pc-meta"><span class="pill">{fcat.label}</span><span>{blog.readingTime.replace('{n}', String(readingMinutes(featured)))}</span>{fdate && <span>{fdate}</span>}</span>
          <b>{featured.data.title}</b>
          <span class="pc-sum">{featured.data.summary}</span>
          <span class="feat-by">{blog.byline}</span>
        </span>
      </a>
      {rest.length > 0 && (
        <div data-blog>
          <div class="filters" role="group" aria-label={blog.filterLabel}>
            <button type="button" aria-pressed="true" data-filter="">{blog.all}</button>
            {used.map((c) => <button type="button" id={c.id} aria-pressed="false" data-filter={c.id}>{c.plural}</button>)}
          </div>
          <div class="pgrid">{rest.map((p) => <PostCard post={p} blog={blog} />)}</div>
        </div>
      )}
    </div>
  </div>
  <Footer />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-blog]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-cat]')];
    const apply = (cat: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
      cards.forEach((c) => { c.hidden = !!cat && c.dataset.cat !== cat; });
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
    const hash = location.hash.slice(1);
    if (buttons.some((b) => b.dataset.filter === hash)) apply(hash);
  });
</script>
