---
/**
 * A blog post: a slim night header and, on paper, category, reading time,
 * date, title and summary; the cover photo; the text with "En esta entrada"
 * (its h2 headings); the next story; and related posts. Stories (category
 * "historia") read like a book: serif, drop cap, no date.
 */
import { Image } from 'astro:assets';
import kit from 'virtual:42chain/kit';
import Base from '../../kit/layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Header from '../../kit/components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../../kit/components/PostCard.astro';
import { catalogRelative } from '../../kit/catalog';
import { homeHref, langPrefix, languages, sourceLang, withLang } from '../../kit/i18n';
import { getSiteText } from '../../kit/site';
import { blogHref, categoryOf, getBlogPosts, categoryTint, postDate, postHref, postLang, readingMinutes, relatedPosts, type Blog, type Post } from '../../kit/blog';
interface Props { post: Post; blog: Blog; headings: { depth: number; slug: string; text: string }[] }
const { post, blog, headings } = Astro.props;
const lang = postLang(post);
const cat = categoryOf(blog, post);
const published = postDate(post);
const date = published && new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(published);
const toc = headings.filter((h) => h.depth === 2);
const related = await relatedPosts(post);
// Stories read like a book; the next story of the same kind gets its own band.
const story = cat.id === 'historia';
const next = story ? related.find((r) => r.data.category === post.data.category) : undefined;
const more = related.filter((r) => r !== next);
const { header: { home }, page: ui } = await getSiteText(lang);
const original = post.fallbackOf;
const canonicalHref = original ? withLang(postHref(blog, post).replace(langPrefix(lang), '') || '/', sourceLang) : undefined;
const index = blogHref(blog, lang);
// Every language serves every post (untranslated ones in the source language).
const postPath = postHref(blog, post).replace(langPrefix(lang), '') || '/';
const alternates = Object.fromEntries(languages.map((l) => [l, withLang(postPath, l)]));
// A category with its own path belongs to that section; the others to the blog, at its
// filter (the index only shows filters when there is more than one post).
const filters = (await getBlogPosts(lang)).length > 1;
const catHref = cat.path ? `${langPrefix(lang)}/${cat.path}` : filters ? `${index}#${cat.id}` : index;
// Breadcrumbs above the title: home / blog / category.
const crumbs = [
  ...(home ? [{ href: homeHref(lang), label: home }] : []),
  ...(cat.path ? [] : [{ href: index, label: blog.kicker }]),
  { href: catHref, label: cat.plural },
];
---
<Base title={post.data.title} description={post.data.summary} canonicalHref={canonicalHref}>
  <Header current={cat.path} currentHref={cat.path ? undefined : index} alternates={alternates} />
  <div class="progress" aria-hidden="true"></div>
  <Cover crumbs={crumbs} crumbsLabel={cat.path ? cat.plural : blog.kicker} title={post.data.title}>
    <span class="pill">{cat.label}</span>
    <span>{blog.readingTime.replace('{n}', String(readingMinutes(post)))}</span>
    {!story && !cat.path && date && <span>{date}</span>}
    <span>{blog.byline}</span>
    {kit.editBase && <a href={kit.editBase + catalogRelative(post.filePath!)}>{blog.editPost}</a>}
  </Cover>
  <div class:list={['rd', 'covered', { story }]}>
    {post.data.image && (
      <figure class="post-cover">
        <div class="duo" style={`--tint: ${categoryTint(blog, cat.id)}`}><Image src={post.data.image as never} alt={post.data.alt!} widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 1100px" /></div>
        <figcaption>{blog.illustrative} {post.data.credit}.</figcaption>
      </figure>
    )}
    <div class="lay post-lay">
      {toc.length > 1 && (
        <aside class="post-toc">
          <p>{blog.onThisPost}</p>
          <nav aria-label={blog.onThisPost}>{toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
        </aside>
      )}
      <main lang={original ? sourceLang : undefined}>
        {original && ui.untranslated && <p class="untranslated" lang={lang}>{ui.untranslated}</p>}
        <div class="prose"><slot /></div>
      </main>
    </div>
    {next && (
      <section class="post-next">
        <a href={postHref(blog, next)}><span class="pn-k">{blog.nextStory ?? blog.keepReading}</span><span class="pn-t">{next.data.title} →</span></a>
      </section>
    )}
    {more.length > 0 && (
      <section class="post-more">
        <p class="pm-k">{blog.keepReading}</p>
        <div class="pm-grid">{more.map((r) => <PostCard post={r} blog={blog} compact />)}</div>
      </section>
    )}
  </div>
  <Footer alternates={alternates} />
</Base>
