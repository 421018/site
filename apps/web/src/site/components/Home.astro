---
/**
 * Home page layout. The texts come from content/<lang>/home.md; this file only
 * decides how they look: a magazine that alternates night (cover, brand
 * moments), paper (what is read) and hull (a feature band between two papers).
 * The central idea is said once, in the editorial; the rest lets it be felt.
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../kit/layouts/Base.astro';
import Header from '../../kit/components/Header.astro';
import Footer from './Footer.astro';
import { isExternal, langOf, resolveHref } from '../../kit/i18n';
import { homeAlternates } from '../../kit/site';
import { categoryOf, getBlog, getBlogPosts, postHref, readingMinutes } from '../../kit/blog';
import PageRing from '../../art/PageRing.astro';
import EngineMesh from '../../art/EngineMesh.astro';
import RingedPlanet from '../../art/RingedPlanet.astro';

const lang = langOf(Astro);
const entry = await getEntry('home', lang);
if (!entry) throw new Error(`Missing content/${lang}/home.md`);
const { title, description, hero, editorial, engine, beliefs, story, vision, work, blog: latest, name, closing } = entry.data;
// The blog: the featured post (else the newest) is the story band; the library repeats it with up to
// three more, so it only shows once there are others.
const blog = await getBlog(lang);
const posts = blog ? await getBlogPosts(lang) : [];
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const more = posts.filter((p) => p !== lead).slice(0, 3);

/** A line break in a YAML title becomes <br>. */
const lines = (s: string) => s.trim().split('\n');
/** Blank lines separate paragraphs. */
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.replace(/\s*\n\s*/g, ' ').trim()).filter(Boolean);
/** A link to another site or any external URL shows ↗; internal links show an arrow. */
const go = (href: string) => resolveHref(href, lang);
const ext = (href: string) => isExternal(go(href));
const arrow = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8 H13 M9 4 L13 8 L9 12" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>';
---
<Base title={title} description={description} alternates={homeAlternates()}>
<Header alternates={homeAlternates()} />
<section class="hero">
<div class="hero-sky stars" aria-hidden="true"></div>
<div class="hero-art" aria-hidden="true"><PageRing /></div>
<div class="hero-field" aria-hidden="true"></div>
<div class="hero-in">
<div class="copy">
<p class="lbl eyebrow fade" style="animation-delay: .1s"><span class="dot"></span>{hero.eyebrow}</p>
<h1 class="fade" style="animation-delay: .2s">{lines(hero.title).map((l, i) => <>{i > 0 && <br />}{i === 0 ? <span class="panic">{l}</span> : l}</>)}</h1>
<p class="hero-lead fade" style="animation-delay: .35s">{hero.lead}</p>
<div class="acts fade" style="animation-delay: .5s">
<a class:list={['btn btn-p', { ext: ext(hero.primary.href) }]} href={go(hero.primary.href)}>{hero.primary.label}{!ext(hero.primary.href) && <Fragment set:html={arrow} />}</a>
<a class:list={['btn btn-g', { ext: ext(hero.secondary.href) }]} href={go(hero.secondary.href)}>{hero.secondary.label}</a>
</div>
</div>
</div>
</section>

<section id="editorial" class="band paper">
<div class="wrap">
<p class="k">{editorial.kicker}</p>
<h2 class="h2 serif wide">{editorial.title}</h2>
<div class="cols">
<div>{paragraphs(editorial.body).map((p) => <p class="body">{p}</p>)}</div>
<div><p class="statement">{editorial.statement}</p>{editorial.aside && <p class="aside">{editorial.aside}</p>}</div>
</div>
</div>
</section>

<section id="engine" class="band night stars">
<div class="wrap">
<div class="cols end">
<div><p class="k">{engine.kicker}</p><h2 class="h2 serif">{engine.title}</h2></div>
<p class="lead">{engine.lead}</p>
</div>
<figure class="engine-fig">
<EngineMesh {...engine.art} />
<figcaption><span>{engine.caption}</span><a class:list={{ ext: ext(engine.link.href) }} href={go(engine.link.href)}>{engine.link.label}{!ext(engine.link.href) && ' →'}</a></figcaption>
</figure>
</div>
</section>

<section id="beliefs" class="band casco">
<div class="wrap">
<p class="k">{beliefs.kicker}</p>
<h2 class="h2 serif wide">{beliefs.title}</h2>
<p class="lead">{beliefs.lead}</p>
<div class="beliefs">{beliefs.items.map((b) => <div><p class="b-title">{b.title}</p><p class="b-text">{b.text}</p></div>)}</div>
<a class="more" href={go(beliefs.link.href)}>{beliefs.link.label} →</a>
</div>
</section>

{blog && lead && (
<section id="story" class="story">
{lead.data.image && <Image class="story-img" src={lead.data.image as never} alt={lead.data.alt!} widths={[800, 1400, 2000]} sizes="100vw" />}
<div class="story-field" aria-hidden="true"></div>
<div class="wrap story-in">
<div class="story-copy">
<p class="k star">{story.kicker}</p>
<p class="story-title">{lead.data.title}</p>
<p class="story-sum">{lead.data.summary}</p>
<a class="more star" href={postHref(blog, lead)}>{story.link} →</a>
</div>
</div>
</section>
)}

<section id="vision" class="band night stars">
<div class="wrap cols center">
<div><p class="k">{vision.kicker}</p><h2 class="h2 serif">{vision.title}</h2></div>
<div>{paragraphs(vision.body).map((p) => <p class="body light">{p}</p>)}<a class:list={['more', { ext: ext(vision.link.href) }]} href={go(vision.link.href)}>{vision.link.label}{!ext(vision.link.href) && ' →'}</a></div>
</div>
</section>

<section id="work" class="band paper">
<div class="wrap cols">
<div><p class="k">{work.kicker}</p><h2 class="h2 serif">{work.title}</h2></div>
<div>{paragraphs(work.body).map((p) => <p class="body">{p}</p>)}<a class="more" href={go(work.link.href)}>{work.link.label} →</a></div>
</div>
</section>

{/* The library appears once there is more than the story above to show. */}
{more.length > 0 && (
<section id="blog" class="band paper tight">
<div class="wrap">
<div class="headrow">
<div><p class="k">{latest.kicker}</p><h2 class="h2">{latest.title}</h2></div>
<a class="more" href={go(latest.link.href)}>{latest.link.label} →</a>
</div>
{blog && lead && (
<div class="logs">
<a class="lfeat" href={postHref(blog, lead)}>
{lead.data.image && <figure class="duo limg"><Image src={lead.data.image as never} alt={lead.data.alt!} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 55vw" /></figure>}
<span class="lmeta">{categoryOf(blog, lead).label} · {blog.readingTime.replace('{n}', String(readingMinutes(lead)))}</span>
<b>{lead.data.title}</b>
</a>
{more.length > 0 && <div class="llist">{more.map((p) => (
<a class="litem" href={postHref(blog, p)}>
<span class="lmeta">{categoryOf(blog, p).label}</span>
<b>{p.data.title}</b>
<span class="lsum">{p.data.summary}</span>
</a>
))}</div>}
</div>
)}
</div>
</section>
)}

<section id="why-42" class="band night">
<div class="wrap lore-row">
<div class="lore-text">
<p class="k star">{name.kicker}</p>
<h2 class="h2">{name.title}</h2>
<p class="lead">{name.lead}</p>
<a class="more star" href={go(name.link.href)}>{name.link.label} →</a>
</div>
<div class="lore-art" aria-hidden="true"><RingedPlanet /></div>
</div>
</section>

<section id="closing" class="band night closing">
<div class="wrap">
<h2 class="h2 serif">{closing.title}</h2>
{closing.lead && <p class="lead">{closing.lead}</p>}
<div class="acts">
<a class:list={['btn btn-p', { ext: ext(closing.primary.href) }]} href={go(closing.primary.href)}>{closing.primary.label}{!ext(closing.primary.href) && <Fragment set:html={arrow} />}</a>
<a class:list={['btn btn-g', { ext: ext(closing.secondary.href) }]} href={go(closing.secondary.href)}>{closing.secondary.label}</a>
</div>
</div>
</section>

<Footer />
</Base>

<style is:global>
/* grounds */
.band{padding:120px 0}
.band.tight{padding-top:0}
.paper{background:var(--bg);color:var(--ink)}
.casco{background:var(--casco);color:#E3ECEB}
.night{background-color:var(--night)}
.wrap{max-width:1280px;margin:0 auto;padding:0 clamp(16px,4vw,40px);box-sizing:border-box}
.k{font-family:var(--mono);font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin:0 0 20px}
.paper .k{color:var(--amber)}
.k.star,.more.star{color:var(--star)}
.h2{margin:0;font-size:clamp(32px,4.8vw,56px);font-weight:500;letter-spacing:-0.035em;line-height:1.04}
.h2.serif{font-family:var(--serif);letter-spacing:-0.015em;line-height:1.06;font-size:clamp(36px,5vw,64px)}
.h2.wide{max-width:980px}
.paper .h2{color:var(--head)}
.casco .h2{color:#F1F5F4}
.lead{margin:24px 0 0;max-width:680px;font-size:18.5px;line-height:1.7;color:var(--fg-2)}
.casco .lead{color:#B4C4C2}
.body{margin:0 0 1.1em;font-size:19px;line-height:1.7}
.body.light{color:var(--fg-2);font-size:18.5px}
.more{display:inline-flex;align-items:center;min-height:44px;margin-top:20px;color:var(--acc);text-decoration:none;font-size:15.5px}
.paper .more{color:var(--link);font-weight:500}
.more:hover{text-decoration:underline;text-underline-offset:4px}
.cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;margin-top:48px}
.wrap.cols{margin-top:0}
.cols.end{align-items:end;margin-top:0}
.cols.center{align-items:center}
.statement{margin:0 0 1.1em;font-family:var(--serif);font-size:27px;line-height:1.4;color:var(--head)}
.aside{margin:0;font-size:16px;line-height:1.7;color:var(--muted)}

/* hero (night) */
.hero{position:relative;overflow:hidden;min-height:clamp(608px,calc(92svh - 72px),788px);display:flex;background-color:var(--night)}
.hero-sky{position:absolute;inset:0;opacity:.9}
.hero-art{position:absolute;right:-90px;top:-62px;width:min(880px,64vw)}
.hero-field{position:absolute;inset:0;background:linear-gradient(90deg,var(--night) 0%,var(--night) 34%,rgba(4,6,11,.75) 50%,rgba(4,6,11,0) 70%)}
.hero-in{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;max-width:1280px;margin:0 auto;padding:0 clamp(16px,4vw,40px) 72px;box-sizing:border-box}
.hero .copy{flex:1;display:flex;flex-direction:column;justify-content:center;padding:72px 0 24px}
.eyebrow{margin:0 0 28px;display:inline-flex;align-items:center;gap:12px;color:var(--fg-3);letter-spacing:.14em}
.hero h1{margin:0;max-width:760px;font-size:clamp(34px,9.6vw,88px);hyphens:manual;font-weight:500;line-height:.98;letter-spacing:-0.045em}
.hero h1 .panic{color:var(--acc)}
.hero-lead{margin:30px 0 0;max-width:580px;font-size:clamp(17px,1.4vw,19px);line-height:1.6;color:var(--fg-2)}
.acts{display:flex;gap:14px;flex-wrap:wrap;margin-top:40px}
@media (max-width:900px){
.hero-art{right:-35%;top:auto;bottom:-6%;width:130vw;opacity:.45}
.hero-field{background:linear-gradient(180deg,var(--night) 0%,var(--night) 55%,rgba(4,6,11,.6) 100%)}
}

/* engine */
.engine-fig{margin:56px 0 0}
.engine-fig figcaption{margin-top:16px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;font-family:var(--mono);font-size:12.5px;color:var(--fg-4)}
.engine-fig figcaption a{color:var(--acc);text-decoration:none}

/* beliefs */
.beliefs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px;margin-top:64px}
.b-title{margin:0 0 12px;font-family:var(--serif);font-size:30px;line-height:1.15;color:#F1F5F4}
.b-text{margin:0;font-size:16px;line-height:1.7;color:#B4C4C2}

/* story band */
.story{position:relative;background:var(--night);min-height:clamp(420px,48vw,660px);display:flex;align-items:center;overflow:hidden}
.story-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5}
.story-field{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,6,11,.95) 0%,rgba(4,6,11,.8) 45%,rgba(4,6,11,.1) 80%)}
.story-in{position:relative;width:100%}
.story-copy{max-width:600px;padding:64px 0}
.story-title{margin:0 0 18px;font-family:var(--serif);font-size:clamp(34px,4vw,52px);line-height:1.05;font-weight:500;color:var(--fg)}
.story-sum{margin:0;font-family:var(--serif);font-size:clamp(20px,2vw,25px);line-height:1.5;color:#D5DAE0}

/* blog */
.headrow{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;padding-bottom:20px;border-bottom:1px solid var(--head)}
.headrow .more{margin-top:0}
.logs{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:24px 56px;margin-top:48px}
.logs a{color:var(--ink);text-decoration:none;display:flex;flex-direction:column;gap:10px}
.logs a:hover b{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
.lfeat .limg{margin:0 0 8px;height:340px;border-radius:16px}
.logs b{font-family:var(--serif);font-weight:500;color:var(--head)}
.lfeat b{font-size:clamp(32px,3.4vw,42px);line-height:1.05}
.llist{display:flex;flex-direction:column}
.litem{padding:24px 0;border-bottom:1px solid var(--rule)}
.litem:first-child{padding-top:0}
.litem:last-child{border-bottom:0}
.litem b{font-size:26px;line-height:1.15}
.lmeta{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--amber)}
.lsum{font-size:15px;line-height:1.6;color:var(--muted)}

/* why 42 */
.lore-row{display:flex;flex-wrap:wrap;align-items:center;gap:32px}
.lore-text{flex:1 1 480px;min-width:0}
.lore-art{flex:1 1 360px;min-width:0;display:flex;justify-content:center}
.lore-art svg{width:100%;max-width:460px;height:auto}

/* closing */
.closing{border-top:1px solid var(--line-d);text-align:center}
.closing .h2{max-width:820px;margin:0 auto}
.closing .lead{max-width:620px;margin:20px auto 0}
.closing .acts{justify-content:center}

@media (max-width:900px){
.band{padding:84px 0}
.cols,.logs,.beliefs{grid-template-columns:1fr}
.cols{gap:32px}
}
</style>
