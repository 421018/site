---
/**
 * Home page. Texts in content/site/<lang>/home.md; this file decides how they
 * look. The cover is the drive field with the main network running live along
 * its rail; then what the network offers (a bento of six capabilities), how
 * Infinite Drive is built (its layers, drawn), ways in, principles, a story
 * from the blog and a closing call.
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../kit/layouts/Base.astro';
import Header from '../../kit/components/Header.astro';
import Footer from './Footer.astro';
import { isExternal, langOf, resolveHref } from '../../kit/i18n';
import { homeAlternates } from '../../kit/site';
import { getBlog, getBlogPosts, postHref } from '../../kit/blog';
import { getDirectory } from '../../network/directory';
import DriveField from '../../art/DriveField.astro';
import Icon from '../../art/Icon.astro';

const lang = langOf(Astro);
const entry = await getEntry('home', lang);
if (!entry) throw new Error(`Missing content/site/${lang}/home.md`);
const { title, description, hero, features, stack, paths, principles, story, closing } = entry.data;
const blog = await getBlog(lang);
const posts = blog ? await getBlogPosts(lang) : [];
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const { networks, providers } = await getDirectory();
const net = networks[0];
const rpcs = providers.filter((p) => p.network === net.id && p.service === 'evm').map((p) => p.url);
const live = { seconds: hero.seconds, block: hero.block, unavailable: hero.unavailable };

const lines = (s: string) => s.trim().split('\n');
const go = (href: string) => resolveHref(href, lang);
const ext = (href: string) => isExternal(go(href));
const arrow = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8 H13 M9 4 L13 8 L9 12" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>';
---
<Base title={title} description={description} alternates={homeAlternates()}>
<Header alternates={homeAlternates()} />

<section class="hx" data-parallax data-home-live data-chain={net.evmChainId} data-rpcs={JSON.stringify(rpcs)} data-i18n={JSON.stringify(live)}>
  <div class="hx-field" aria-hidden="true"><div data-depth="-14"><DriveField /></div></div>
  <div class="hx-shade" aria-hidden="true"></div>
  <div class="hx-in">
    <div class="hx-copy">
      <p class="hx-status fade"><span class="live-dot" aria-hidden="true"></span>{hero.status}<span class="hx-h" data-v="height">—</span></p>
      <h1 class="fade" style="animation-delay:.08s">{lines(hero.title).map((l, i) => <span class:list={['hx-line', { grad: i === 0 }]}>{l}</span>)}</h1>
      <p class="hx-lead fade" style="animation-delay:.18s">{hero.lead}</p>
      <div class="acts fade" style="animation-delay:.28s">
        <a class="btn btn-p" href={go(hero.primary.href)}>{hero.primary.label}<Fragment set:html={arrow} /></a>
        <a class="btn btn-g" href={go(hero.secondary.href)}><span class="live-dot" aria-hidden="true"></span>{hero.secondary.label}</a>
      </div>
    </div>
    <div class="hx-rail fade" style="animation-delay:.4s">
      <dl class="hx-stats">
        <div><dt>{hero.height}</dt><dd data-v="height">—</dd></div>
        <div><dt>{hero.pace}</dt><dd data-v="pace">—</dd></div>
        <div><dt>{hero.finality}</dt><dd>{hero.finalityValue}</dd></div>
        <div><dt>{hero.chain}</dt><dd>{net.evmChainId}</dd></div>
      </dl>
      <div class="hx-stream" aria-hidden="true"><ol class="lb-blocks" data-blocks></ol></div>
      <p class="hx-state" data-state aria-live="polite"></p>
    </div>
  </div>
</section>

<section id="features" class="sx">
  <div class="wrap">
    <header class="sx-head">
      <p class="k" data-rv>{features.kicker}</p>
      <h2 class="h2" data-rv>{features.title}</h2>
      <p class="lead" data-rv>{features.lead}</p>
    </header>
    <ul class="bento">
      {features.items.map((f, i) => {
        const Tag = f.href ? 'a' : 'div';
        return (
          <li class={`b b${i + 1}`} data-rv>
            <Tag class="b-card spot" href={f.href ? go(f.href) : undefined}>
              <span class="b-ic"><Icon name={f.icon} size={26} /></span>
              <b>{f.title}</b>
              <span class="b-t">{f.text}</span>
              {i === 0 && <code class="b-code" aria-hidden="true"><span class="c-k">chainId</span>: <span class="c-n">{net.evmChainId}</span><br /><span class="c-k">rpc</span>: <span class="c-s">"{rpcs[0]?.replace(/^https?:\/\//, '')}"</span></code>}
              {i === 1 && <span class="b-final" aria-hidden="true"><i></i><i></i><i></i><i class="ok"></i></span>}
              {i === 5 && <span class="b-lic" aria-hidden="true">Apache 2.0</span>}
              {f.href && <span class="b-go" aria-hidden="true"><Fragment set:html={arrow} /></span>}
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<section id="stack" class="sx sx-stack">
  <div class="wrap stack-row">
    <div class="stack-copy">
      <p class="k" data-rv>{stack.kicker}</p>
      <h2 class="h2" data-rv>{stack.title}</h2>
      <p class="lead" data-rv>{stack.lead}</p>
      <a class="btn btn-g" href={go(stack.link.href)} data-rv>{stack.link.label}<Fragment set:html={arrow} /></a>
    </div>
    <div class="stack-art" data-rv>
      <ol class="layers">
        {stack.layers.map((l, i) => (
          <li style={`--i:${i}`}>
            <span class="l-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="l-b"><b>{l.label}</b><span>{l.text}</span></span>
            <span class="l-tag">{l.tag}</span>
          </li>
        ))}
      </ol>
      <div class="ibc"><b>{stack.side.label}</b><span>{stack.side.text}</span></div>
      <span class="flow" aria-hidden="true"></span>
    </div>
  </div>
</section>

<section id="paths" class="sx">
  <div class="wrap">
    <header class="sx-head">
      <p class="k" data-rv>{paths.kicker}</p>
      <h2 class="h2" data-rv>{paths.title}</h2>
    </header>
    <ul class="pth">
      {paths.items.map((p, i) => (
        <li data-rv style={`--n:${i}`}>
          <a class:list={['pth-card spot', { ext: ext(p.href) }]} href={go(p.href)}>
            <span class="pth-ic"><Icon name={p.icon} size={28} /></span>
            <b>{p.title}</b>
            <span class="pth-t">{p.text}</span>
            <span class="pth-go" aria-hidden="true"><Fragment set:html={arrow} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="principles" class="sx sx-pr">
  <div class="wrap">
    <header class="sx-head row">
      <div><p class="k" data-rv>{principles.kicker}</p><h2 class="h2" data-rv>{principles.title}</h2></div>
      <a class="more" href={go(principles.link.href)} data-rv>{principles.link.label} →</a>
    </header>
    <ol class="pr">
      {principles.items.map((p, i) => <li data-rv><span class="pr-n">{String(i + 1).padStart(2, '0')}</span><b>{p.title}</b><span>{p.text}</span></li>)}
    </ol>
  </div>
</section>

{blog && lead && (
<section id="story" class="story">
  {lead.data.image && <Image class="story-img" src={lead.data.image as never} alt={lead.data.alt!} widths={[800, 1400, 2000]} sizes="100vw" />}
  <div class="story-field" aria-hidden="true"></div>
  <div class="wrap story-in">
    <div class="story-copy" data-rv>
      <p class="k star">{story.kicker}</p>
      <p class="story-title">{lead.data.title}</p>
      <p class="story-sum">{lead.data.summary}</p>
      <a class="btn btn-g" href={postHref(blog, lead)}>{story.link}<Fragment set:html={arrow} /></a>
    </div>
  </div>
</section>
)}

<section id="closing" class="cl">
  <div class="cl-glow" aria-hidden="true"></div>
  <div class="wrap cl-in">
    <h2 class="h2" data-rv>{lines(closing.title).map((l) => <span>{l}</span>)}</h2>
    {closing.lead && <p class="lead" data-rv>{closing.lead}</p>}
    <div class="acts" data-rv>
      <a class="btn btn-p" href={go(closing.primary.href)}>{closing.primary.label}<Fragment set:html={arrow} /></a>
      <a class="btn btn-g" href={go(closing.secondary.href)}>{closing.secondary.label}</a>
    </div>
  </div>
</section>

<Footer alternates={homeAlternates()} />
</Base>

<script>
  import { mountStream } from '../../network/live';
  document.querySelectorAll<HTMLElement>('[data-home-live]').forEach((root) => {
    mountStream(root, { urls: JSON.parse(root.dataset.rpcs!), chain: Number(root.dataset.chain), t: JSON.parse(root.dataset.i18n!), keep: 22, seed: 16 });
  });
</script>

<style is:global>
.wrap{max-width:1280px;margin:0 auto;padding:0 clamp(16px,4vw,40px);box-sizing:border-box}
.k{font-family:var(--mono);font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin:0 0 18px}
.k.star{color:var(--star)}
.h2{margin:0;font-size:clamp(34px,4.6vw,60px);font-weight:600;letter-spacing:-0.045em;line-height:1.02;color:var(--fg)}
.lead{margin:20px 0 0;max-width:640px;font-size:18px;line-height:1.65;color:var(--fg-3)}
.more{display:inline-flex;align-items:center;min-height:44px;color:var(--acc);text-decoration:none;font-size:15.5px}
.more:hover{text-decoration:underline;text-underline-offset:4px}
.acts{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.btn-g .live-dot{margin-right:2px}
.grad{background:linear-gradient(92deg,#5BF0C8 0%,#7C9CFF 55%,#F2C879 100%);-webkit-background-clip:text;background-clip:text;color:transparent}

/* hero */
.hx{position:relative;overflow:hidden;min-height:clamp(640px,calc(100svh - 72px),860px);display:flex;background:var(--night)}
.hx-field{position:absolute;inset:-20px}
.hx-field > div{width:100%;height:100%;transition:transform .9s cubic-bezier(.16,1,.3,1)}
.hx-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,6,11,.9) 0%,rgba(4,6,11,.6) 34%,rgba(4,6,11,0) 58%),linear-gradient(0deg,rgba(4,6,11,.9) 0%,rgba(4,6,11,0) 30%)}
.hx-in{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:space-between;gap:48px;max-width:1280px;margin:0 auto;padding:56px clamp(16px,4vw,40px) 32px;box-sizing:border-box;width:100%}
.hx-status{display:inline-flex;align-items:center;gap:12px;margin:0 0 28px;padding:7px 14px 7px 12px;border:1px solid rgba(91,240,200,.25);border-radius:999px;background:rgba(91,240,200,.06);font-family:var(--mono);font-size:12.5px;letter-spacing:.04em;color:var(--fg-2)}
.hx-h{padding-left:12px;border-left:1px solid rgba(255,255,255,.14);color:var(--fg);font-variant-numeric:tabular-nums}
.hx h1{margin:0;max-width:900px;font-size:clamp(44px,6.6vw,88px);font-weight:600;line-height:.98;letter-spacing:-0.055em;color:var(--fg)}
.hx-line{display:block}
.hx-lead{margin:24px 0 0;max-width:620px;font-size:clamp(17px,1.4vw,19.5px);line-height:1.6;color:var(--fg-2)}
.hx-rail{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:end;gap:24px 48px;padding:22px 24px;border:1px solid rgba(255,255,255,.08);border-radius:20px;background:rgba(7,10,16,.6);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.hx-stats{display:flex;gap:16px 40px;flex-wrap:wrap;margin:0}
.hx-stats dt{font-size:12px;color:var(--fg-4)}
.hx-stats dd{margin:6px 0 0;font-family:var(--mono);font-size:clamp(18px,1.8vw,24px);color:var(--fg);font-variant-numeric:tabular-nums}
.hx-stream{min-width:0;-webkit-mask:linear-gradient(90deg,transparent,#000 30%);mask:linear-gradient(90deg,transparent,#000 30%)}
.hx-stream .lb-blocks{min-height:62px;gap:10px}
.hx-stream .lb-sq{width:30px;height:30px;border-radius:8px}
.hx-stream .lb-b + .lb-b::before{top:15px;width:12px}
.hx-state{grid-column:1 / -1;margin:0;font-family:var(--mono);font-size:12px;color:var(--fg-4)}
.hx-state:empty{display:none}

/* sections */
.sx{padding:136px 0;background:var(--night)}
.sx-head{max-width:820px;margin-bottom:56px}
.sx-head.row{max-width:none;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}

/* bento */
.bento{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;margin:0;padding:0;list-style:none}
.b{display:flex}
.b1{grid-column:span 4}.b2,.b3,.b4,.b5{grid-column:span 2}.b6{grid-column:span 6}
.b6 .b-card{min-height:0;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;column-gap:24px;background:linear-gradient(90deg,rgba(242,200,121,.06),transparent 60%),linear-gradient(180deg,#0A0F17,#06090E)}
.b6 .b-ic{grid-row:span 2;margin:0}.b6 .b-t{grid-column:2}.b6 .b-lic{position:static;grid-row:span 2;grid-column:3;font-size:14px;padding:8px 14px}.b6 .b-go{display:none}
.b-card{position:relative;flex:1;display:flex;flex-direction:column;gap:12px;min-height:250px;padding:30px 28px 26px;border:1px solid var(--line-d2);border-radius:22px;background:linear-gradient(180deg,#0A0F17,#06090E);color:var(--fg-2);text-decoration:none;overflow:hidden;transition:transform .45s cubic-bezier(.16,1,.3,1),border-color .3s}
a.b-card:hover{transform:translateY(-5px);border-color:rgba(91,240,200,.22)}
.b-ic{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;margin-bottom:10px;border-radius:15px;background:rgba(91,240,200,.08);color:var(--aurora)}
.b-card b{font-size:23px;font-weight:600;letter-spacing:-0.025em;color:var(--fg)}
.b-t{max-width:520px;font-size:15.5px;line-height:1.6;color:var(--fg-3)}
.b-go{margin-top:auto;padding-top:14px;color:var(--aurora);transition:transform .35s cubic-bezier(.16,1,.3,1)}
a.b-card:hover .b-go{transform:translateX(6px)}
.b-code{position:absolute;right:26px;top:28px;padding:14px 16px;border:1px solid var(--line-d2);border-radius:12px;background:#05080C;font-family:var(--mono);font-size:13px;line-height:1.8;color:var(--fg-3)}
.c-k{color:#7C9CFF}.c-n{color:var(--star)}.c-s{color:var(--aurora)}
.b-final{position:absolute;right:24px;top:30px;display:flex;gap:6px}
.b-final i{width:16px;height:16px;border-radius:5px;border:1.5px solid rgba(91,240,200,.5)}
.b-final i.ok{background:var(--star);border-color:var(--star);box-shadow:0 0 16px rgba(242,200,121,.6);animation:fin 2.6s ease-in-out infinite}
@keyframes fin{0%,100%{transform:scale(1)}50%{transform:scale(1.18)}}
.b-lic{position:absolute;right:24px;top:28px;font-family:var(--mono);font-size:12px;padding:5px 10px;border:1px solid rgba(242,200,121,.4);border-radius:999px;color:var(--star)}

/* stack */
.sx-stack{background:radial-gradient(900px 500px at 80% 50%,rgba(124,156,255,.08),transparent 70%),var(--night)}
.stack-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:56px;align-items:center}
.stack-copy .btn{margin-top:32px}
.stack-art{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 88px;gap:12px}
.layers{display:flex;flex-direction:column;gap:10px;margin:0;padding:0;list-style:none}
.layers li{display:grid;grid-template-columns:34px minmax(0,1fr) auto;align-items:center;gap:14px;padding:18px 20px;border:1px solid var(--line-d2);border-radius:16px;background:linear-gradient(90deg,rgba(91,240,200,calc(.10 - var(--i) * .02)),rgba(124,156,255,.03)),#080C12}
.l-n{font-family:var(--mono);font-size:12px;color:var(--aurora)}
.l-b{display:flex;flex-direction:column;gap:3px}
.l-b b{font-size:17px;font-weight:600;color:var(--fg)}
.l-b span{font-size:14px;line-height:1.45;color:var(--fg-3)}
.l-tag{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--fg-4)}
.ibc{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:8px;padding:16px 8px;border:1px dashed rgba(242,200,121,.45);border-radius:16px;text-align:center;background:rgba(242,200,121,.04)}
.ibc b{font-family:var(--mono);font-size:14px;color:var(--star);writing-mode:vertical-rl;transform:rotate(180deg);letter-spacing:.2em}
.ibc span{font-size:11.5px;line-height:1.4;color:var(--fg-4)}
.flow{position:absolute;left:36px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,transparent,rgba(91,240,200,.9),transparent);background-size:100% 40%;background-repeat:no-repeat;animation:flow 3.2s cubic-bezier(.65,0,.35,1) infinite;filter:drop-shadow(0 0 6px #5BF0C8);pointer-events:none}
@keyframes flow{from{background-position:0 -60%}to{background-position:0 160%}}

/* paths */
.pth{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:0;padding:0;list-style:none}
.pth li{display:flex}
.pth-card{flex:1;display:flex;flex-direction:column;gap:12px;min-height:260px;padding:28px 26px 24px;border:1px solid var(--line-d2);border-radius:22px;background:linear-gradient(180deg,#0A0F17,#06090E);color:var(--fg-2);text-decoration:none;transition:transform .45s cubic-bezier(.16,1,.3,1),border-color .3s}
.pth-card:hover{transform:translateY(-6px);border-color:rgba(91,240,200,.22)}
.pth-ic{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;margin-bottom:12px;border-radius:16px;background:rgba(91,240,200,.08);color:var(--aurora);transition:transform .45s cubic-bezier(.16,1,.3,1)}
.pth-card:hover .pth-ic{transform:rotate(-8deg) scale(1.08)}
.pth-card b{font-size:21px;font-weight:600;letter-spacing:-0.02em;color:var(--fg)}
.pth-t{font-size:15px;line-height:1.6;color:var(--fg-3)}
.pth-go{margin-top:auto;padding-top:16px;color:var(--aurora);transition:transform .35s cubic-bezier(.16,1,.3,1)}
.pth-card:hover .pth-go{transform:translateX(6px)}
.pth-card.ext::after{content:none}

/* principles */
.sx-pr{border-top:1px solid var(--line-d)}
.pr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:0;padding:0;list-style:none}
.pr li{position:relative;display:flex;flex-direction:column;gap:12px;padding:30px 4px 0}
.pr li::before{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,#5BF0C8,#7C9CFF 50%,transparent)}
.pr-n{font-family:var(--mono);font-size:12px;color:var(--fg-4)}
.pr b{font-size:clamp(24px,2.4vw,30px);font-weight:600;letter-spacing:-0.03em;color:var(--fg)}
.pr li > span:last-child{font-size:16px;line-height:1.6;color:var(--fg-3);max-width:360px}

/* story */
.story{position:relative;background:var(--night);min-height:clamp(440px,46vw,640px);display:flex;align-items:center;overflow:hidden}
.story-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}
.story-field{position:absolute;inset:0;background:radial-gradient(70% 90% at 18% 50%,rgba(4,6,11,.9),rgba(4,6,11,0) 70%),linear-gradient(90deg,rgba(4,6,11,.98) 0%,rgba(4,6,11,.94) 38%,rgba(4,6,11,.72) 56%,rgba(4,6,11,.2) 82%,rgba(4,6,11,.05) 100%)}
@media (max-width:900px){.story-field{background:linear-gradient(90deg,rgba(4,6,11,.95),rgba(4,6,11,.85))}}
.story-in{position:relative;width:100%}
.story-copy{max-width:600px;padding:64px 0}
.story-title{margin:0 0 18px;font-family:var(--font-newsreader);font-size:clamp(38px,4.4vw,58px);line-height:1.02;font-weight:500;color:var(--fg)}
.story-sum{margin:0 0 28px;font-family:var(--font-newsreader);font-size:clamp(20px,2vw,24px);line-height:1.5;color:#D5DAE0}

/* closing */
.cl{position:relative;overflow:hidden;padding:160px 0;background:var(--night);text-align:center;border-top:1px solid var(--line-d)}
.cl-glow{position:absolute;left:50%;top:100%;width:1200px;height:700px;transform:translate(-50%,-55%);background:radial-gradient(closest-side,rgba(91,240,200,.22),rgba(124,156,255,.10) 50%,transparent);animation:clglow 8s ease-in-out infinite alternate}
@keyframes clglow{to{transform:translate(-50%,-62%) scale(1.08)}}
.cl-in{position:relative}
.cl .h2{max-width:900px;margin:0 auto}
.cl .h2 span{display:block}
.cl .lead{max-width:600px;margin:22px auto 0}
.cl .acts{justify-content:center}

@media (max-width:1100px){.pth{grid-template-columns:repeat(2,minmax(0,1fr))}.bento{grid-template-columns:repeat(2,minmax(0,1fr))}.b1,.b2,.b3,.b4,.b5{grid-column:span 1}.b1,.b6{grid-column:span 2}.stack-row{grid-template-columns:1fr}}
@media (max-width:900px){.sx{padding:96px 0}.hx-rail{grid-template-columns:1fr}.pr{grid-template-columns:1fr}.hx-shade{background:linear-gradient(180deg,rgba(4,6,11,.9) 0%,rgba(4,6,11,.75) 55%,rgba(4,6,11,.9) 100%)}}
