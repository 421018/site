---
/**
 * Live status of each network, read from the browser: every public EVM RPC in
 * the provider directory is asked, in one batch, for its chain id, latest
 * block and gas price, every ten seconds (paused while the tab is hidden).
 * Shows the latest block, the time per block (averaged over the last 50
 * blocks, from the chain's own timestamps), the providers online and the gas price;
 * `full` adds a row per provider. The network switch shows one network at a
 * time; without JavaScript, a note.
 */
import { getDirectory, pick } from '../network/directory';
import { langOf } from '../kit/i18n';
import { getConsoleText } from './text';
interface Props { full?: boolean }
const { full = false } = Astro.props;
const lang = langOf(Astro);
const t = (await getConsoleText(lang)).status;
const { networks, providers } = await getDirectory();
const i18n = { ok: t.ok, behind: t.behind, down: t.down, wrongChain: t.wrongChain, checking: t.checking, seconds: t.seconds, updated: t.updated, chartAvg: t.chartAvg, chartBar: t.chartBar };
---
<div class="cx-live" data-live data-i18n={JSON.stringify(i18n)}>
  {networks.map((n) => {
    const evm = providers.filter((p) => p.network === n.id && p.service === 'evm');
    return (
      <section data-for-net={n.id} data-live-net={n.id} data-chain={n.evmChainId}>
        <div class="cx-net"><b>{pick(n.label, lang)}</b><code>{n.chainId}</code></div>
        <dl class="cx-stats">
          <div class="cx-stat"><dt>{t.height}</dt><dd data-v="height">—</dd></div>
          <div class="cx-stat"><dt>{t.blockTime}</dt><dd data-v="pace">—</dd></div>
          <div class="cx-stat"><dt>{t.online}</dt><dd data-v="online">—</dd></div>
          <div class="cx-stat"><dt>{t.gas}</dt><dd data-v="gas">—</dd></div>
        </dl>
        <figure class="cx-chart" data-chart>
          <figcaption><span>{t.chartTitle}</span><span class="cx-chart-avg" data-avg></span></figcaption>
          <div class="cx-chart-plot"><svg viewBox="0 0 600 120" preserveAspectRatio="none" role="img" aria-label={t.chartTitle} data-plot></svg><div class="cx-tip" data-tip hidden></div></div>
        </figure>
        {full && (
          <div class="cx-wrap" style="margin-top: 14px">
            <table class="cx-table cx-fixed">
              <thead><tr><th>{t.provider}</th><th class="cx-col-url">{t.endpoint}</th><th>{t.state}</th><th class="num">{t.height}</th><th class="num">{t.latency}</th></tr></thead>
              <tbody>
                {evm.map((p) => (
                  <tr data-rpc={p.url}>
                    <td>{p.provider}</td>
                    <td class="cx-url cx-col-url">{p.url.replace(/^https:\/\//, '')}</td>
                    <td><span class="cx-st" data-s="checking" data-v="state">{t.checking}</span></td>
                    <td class="num" data-v="height">—</td>
                    <td class="num" data-v="ms">—</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {!full && evm.map((p) => <span hidden data-rpc={p.url}></span>)}
      </section>
    );
  })}
  <p class="cx-note" data-live-updated aria-live="polite"></p>
  {full && <p class="cx-note">{t.downNote}</p>}
  <noscript><p class="cx-note">{t.noscript}</p></noscript>
</div>

<script>
  import { BEHIND, blockPace, blockTimes, readNetwork } from '../network/live';
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((root) => {
    const t = JSON.parse(root.dataset.i18n!) as Record<string, string>;
    const locale = document.documentElement.lang || undefined;
    const num = new Intl.NumberFormat(locale);
    const gwei = new Intl.NumberFormat(locale, { maximumFractionDigits: 2 });
    const clock = new Intl.DateTimeFormat(locale, { timeStyle: 'medium' });
    const nets = [...root.querySelectorAll<HTMLElement>('[data-live-net]')];
    const pace = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const paced = new Set<HTMLElement>();
    // The chart: the time between each of the last 60 blocks, read once and then extended.
    const SPAN = 60;
    const series = new Map<HTMLElement, { height: number; time: number }[]>();
    const draw = (net: HTMLElement) => {
      const pts = series.get(net) ?? [];
      const svg = net.querySelector<SVGSVGElement>('[data-plot]');
      if (!svg || pts.length < 2) return;
      const gaps = pts.slice(1).map((p, i) => ({ h: p.height, s: p.time - pts[i].time }));
      const avg = gaps.reduce((a, g) => a + g.s, 0) / gaps.length;
      const max = Math.max(avg * 2, ...gaps.map((g) => g.s), 1);
      const w = 600 / SPAN, H = 120;
      const bars = gaps.map((g, i) => {
        const x = 600 - (gaps.length - i) * w;
        const h = Math.max(2, (g.s / max) * (H - 8));
        return `<rect class="bar${i === gaps.length - 1 ? ' now' : ''}" data-i="${i}" x="${(x + 1).toFixed(1)}" y="${(H - h).toFixed(1)}" width="${(w - 2).toFixed(1)}" height="${h.toFixed(1)}" rx="2" />`;
      }).join('');
      const ay = H - (avg / max) * (H - 8);
      svg.innerHTML = `<line class="avg" x1="0" x2="600" y1="${ay.toFixed(1)}" y2="${ay.toFixed(1)}" />${bars}`;
      const a = net.querySelector('[data-avg]');
      if (a) a.textContent = t.chartAvg.replace('{n}', pace.format(avg));
      (svg as any)._gaps = gaps;
    };
    root.querySelectorAll<HTMLElement>('[data-chart]').forEach((fig) => {
      const svg = fig.querySelector<SVGSVGElement>('[data-plot]')!;
      const tip = fig.querySelector<HTMLElement>('[data-tip]')!;
      svg.addEventListener('pointermove', (e) => {
        const gaps = (svg as any)._gaps as { h: number; s: number }[] | undefined;
        if (!gaps) return;
        const r = svg.getBoundingClientRect();
        const slot = Math.floor(((e.clientX - r.left) / r.width) * SPAN);
        const i = gaps.length - (SPAN - slot);
        const g = gaps[i];
        svg.querySelectorAll('.bar.hover').forEach((b) => b.classList.remove('hover'));
        if (!g) { tip.hidden = true; return; }
        svg.querySelector(`.bar[data-i="${i}"]`)?.classList.add('hover');
        tip.textContent = t.chartBar.replace('{h}', num.format(g.h)).replace('{n}', String(g.s));
        tip.hidden = false;
        tip.style.left = `${Math.min(Math.max(e.clientX - r.left, 60), r.width - 60)}px`;
      });
      svg.addEventListener('pointerleave', () => { tip.hidden = true; svg.querySelectorAll('.bar.hover').forEach((b) => b.classList.remove('hover')); });
    });
    const set = (el: Element, key: string, text: string) => { const v = el.querySelector(`[data-v="${key}"]`); if (v) v.textContent = text; };
    const refresh = async () => {
      if (document.hidden) return;
      await Promise.all(nets.map(async (net) => {
        const chain = Number(net.dataset.chain);
        const rows = [...net.querySelectorAll<HTMLElement>('[data-rpc]')];
        const { results, top: best, topUrl, online } = await readNetwork(rows.map((row) => row.dataset.rpc!), chain);
        const top = best ?? { height: 0, time: 0, gas: 0 };
        rows.forEach((row, i) => {
          const r = results[i];
          const state = !r.ok ? 'down' : r.chain !== chain ? 'wrong' : r.height < top.height - BEHIND ? 'behind' : 'ok';
          const label = { down: t.down, wrong: t.wrongChain, behind: t.behind, ok: t.ok }[state];
          const st = row.querySelector<HTMLElement>('[data-v="state"]');
          if (st) { st.dataset.s = state; st.textContent = label; }
          set(row, 'height', r.ok ? num.format(r.height) : '—');
          set(row, 'ms', r.ok ? `${r.ms} ms` : '—');
        });
        set(net, 'online', `${online} / ${rows.length}`);
        if (top.height) {
          set(net, 'height', num.format(top.height));
          set(net, 'gas', `${gwei.format(top.gas / 1e9)} gwei`);
          // Time per block: averaged over the last 50 blocks, read once (no need to wait for a second reading).
          if (!paced.has(net) && best && topUrl) { paced.add(net); blockPace(topUrl, best).then((s) => s && set(net, 'pace', t.seconds.replace('{n}', pace.format(s)))); }
          if (best && topUrl) {
            const pts = series.get(net) ?? [];
            const lastH = pts.at(-1)?.height ?? best.height - SPAN - 1;
            if (best.height > lastH) blockTimes(topUrl, Math.max(lastH + 1, best.height - SPAN), best.height).then((more) => {
              const all = [...(series.get(net) ?? []), ...more].filter((p, i, a) => a.findIndex((q) => q.height === p.height) === i).slice(-(SPAN + 1));
              series.set(net, all); draw(net);
            });
          }
        }
      }));
      const upd = root.querySelector('[data-live-updated]');
      if (upd) upd.textContent = t.updated.replace('{time}', clock.format(new Date()));
    };
    refresh();
    setInterval(refresh, 10_000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  });
</script>
