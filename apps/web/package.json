{
  "name": "@42chain/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "42chain.org: the site (home, project, blog, questions) and the documentation at /docs.",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && pagefind --site dist/docs",
    "preview": "astro preview --port 4300",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "verify": "astro check && npm run build && node scripts/check-links.mjs"
  },
  "dependencies": {
    "@42chain/ui": "*",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12",
    "satteri": "0.11.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "pagefind": "1.6.0"
  },
  "license": "Apache-2.0"
}
