---
import { getMenu, getSiteText } from '../lib/site';
interface Props { current?: string }
const { current } = Astro.props;
const menu = await getMenu();
const text = await getSiteText();
---
<header class="site-header">
  <a class="brand" href="/" aria-label={text.header.homeLink}>
    <span class="mark">42</span><span class="name">{text.name}</span>
  </a>
  <nav class="menu" aria-label={text.header.mainNav}>
    {menu.map((s) => (
      <a class:list={['nl', { on: current === s.key }]} href={s.href} data-label={s.label} aria-current={current === s.key ? 'true' : undefined}>{s.label}</a>
    ))}
  </nav>
  {/* Narrow screens: the same links behind a disclosure (no script, CSP-safe). */}
  <details class="menu-m">
    <summary class="nl">{text.header.menuButton}</summary>
    <nav aria-label={text.header.mainNav}>
      {menu.map((s) => (
        <a class:list={['ml', { on: current === s.key }]} href={s.href} aria-current={current === s.key ? 'true' : undefined}>{s.label}</a>
      ))}
    </nav>
  </details>
</header>
