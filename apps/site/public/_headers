# Cloudflare Pages response headers. The Content-Security-Policy is emitted by
# Astro as a <meta> tag on every page (astro.config.mjs → security.csp), with
# hashes for its scripts; frame-ancestors can only be sent as a header.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
