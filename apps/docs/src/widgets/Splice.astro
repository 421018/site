---
/**
 * Places widgets in a rendered page. The content blocks turn
 * :::widget{name="x"} into an empty <div data-widget="x"></div>; this component
 * renders the page (its default slot), cuts it at those markers and puts the
 * real component in each place. Content stays plain Markdown, with no code.
 */
import FeeCalc from './FeeCalc.astro';
import UnitConverter from './UnitConverter.astro';
import ConsensusSim from './ConsensusSim.astro';
import VoteSim from './VoteSim.astro';
import IbcSim from './IbcSim.astro';
import NetworkSwitch from '../network/components/NetworkSwitch.astro';
import NetworkParams from '../network/components/NetworkParams.astro';
import ProviderDirectory from '../network/components/ProviderDirectory.astro';
import AddNetwork from '../network/components/AddNetwork.astro';
import type { WidgetName } from './names';

const components: Record<WidgetName, (props: Record<string, never>) => unknown> = {
  'fee-calc': FeeCalc,
  'unit-converter': UnitConverter,
  'consensus-sim': ConsensusSim,
  'vote-sim': VoteSim,
  'ibc-sim': IbcSim,
  'network-switch': NetworkSwitch,
  'network-params': NetworkParams,
  'provider-directory': ProviderDirectory,
  'add-network': AddNetwork,
};

const html = await Astro.slots.render('default');
// split() with a capture group alternates: html, name, html, name, html…
const parts = html.split(/<div data-widget="([a-z0-9-]+)"><\/div>/);
---
{parts.map((part, i) => {
  if (i % 2 === 0) return <Fragment set:html={part} />;
  const Widget = components[part as WidgetName];
  if (!Widget) throw new Error(`Unknown widget "${part}" in the page.`);
  return <Widget />;
})}
