---
/**
 * Home page of the documentation: the text comes from src/content/home.md and
 * one card per section from the content folders.
 */
import { getEntry, getCollection } from 'astro:content';
import Base from '@42chain/kit/layouts/Base.astro';
import Header from '@42chain/kit/components/Header.astro';
import Footer from '@42chain/kit/components/Footer.astro';
import { getMenu } from '@42chain/kit/site';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('Missing src/content/home.md');
const { eyebrow, title, lead, searchPrompt } = entry.data;
const menu = await getMenu();
const pages = await getCollection('pages');
const summaryOf = (key: string) => pages.find((p) => p.id === key)?.data.summary ?? '';
---
<Base>
  <section class="band-top">
    <div class="band-deco" aria-hidden="true"><div class="gridbg"></div><div class="glow"></div></div>
    <Header />
    <div class="dhero">
      <p class="lbl">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <button type="button" class="sprompt" data-search-open>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.6"></path></svg>
        <span>{searchPrompt}</span><kbd>/</kbd>
      </button>
    </div>
  </section>
  <div class="rd">
    <div class="cards">
      {menu.map((s) => (
        <a class="card" href={s.href} style={s.ink ? `--card: ${s.ink}` : undefined}>
          <span class="ck">{s.label}</span>
          <span class="cs">{summaryOf(s.key)}</span>
          <span class="ca" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
  <Footer />
</Base>

<style>
  .dhero { position: relative; max-width: 860px; padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 72px); }
  .dhero .lbl { margin: 0 0 18px; color: var(--acc); }
  .dhero h1 { margin: 0; font-size: clamp(34px, 5vw, 60px); font-weight: 600; line-height: 1.05; letter-spacing: -0.035em; color: #fff; }
  .dhero .lead { margin: 22px 0 0; max-width: 640px; font-size: clamp(16px, 1.4vw, 19px); line-height: 1.55; color: #C9D0D6; }
  .sprompt { margin-top: 32px; display: inline-flex; align-items: center; gap: 12px; min-height: 52px; width: min(520px, 100%); padding: 0 16px; border: 1px solid #2A313A; border-radius: 12px; background: rgba(5,7,10,.6); color: #8A939C; font: inherit; font-size: 15px; text-align: left; cursor: pointer; transition: border-color .2s; }
  .sprompt:hover { border-color: var(--acc); }
  .sprompt span { flex: 1; }
  .sprompt kbd { font-family: var(--mono); font-size: 12px; padding: 2px 8px; border: 1px solid #2A313A; border-radius: 6px; }
  .cards { max-width: 1240px; margin: 0 auto; padding: 48px clamp(16px, 4vw, 56px) 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .card { position: relative; display: flex; flex-direction: column; gap: 10px; min-height: 170px; padding: 22px; border: 1px solid var(--rule); border-radius: 16px; background: var(--bg); color: var(--ink); text-decoration: none; transition: border-color .2s, transform .2s; }
  .card:hover { border-color: var(--card, var(--link)); transform: translateY(-2px); }
  .ck { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--card, var(--link)); }
  .cs { font-size: 15.5px; line-height: 1.55; color: var(--ink); }
  .ca { margin-top: auto; color: var(--card, var(--link)); }
</style>
