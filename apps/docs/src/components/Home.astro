---
/**
 * Home page of the documentation: title and search, one card per section
 * (label and summary of its index.md; the first one leads), the layers of the
 * protocol and quick data of the default network, from the catalog's network data.
 */
import { getEntry } from 'astro:content';
import Base from '../kit/layouts/Base.astro';
import Footer from '../kit/components/Footer.astro';
import { getMenu, homeAlternates } from '../kit/site';
import { langOf, resolveHref } from '../kit/i18n';
import { ui } from '../kit/dictionary';
import { getDirectory, firstOf, pick } from '../network/directory';
import DocsHeader from './DocsHeader.astro';
import '../styles/docs.css';

const lang = langOf(Astro);
const entry = await getEntry('home', lang);
if (!entry) throw new Error(`Missing docs/${lang}/home.md in the content catalog`);
const { eyebrow, title, lead, searchPrompt, layers, quickData } = entry.data;
const menu = await getMenu(lang);
const { networks, services, providers } = await getDirectory();
const net = networks[0];
const evm = firstOf(providers, net.id, 'evm');
const t = ui(lang).network;
const evmLabel = pick(services.find((s) => s.id === 'evm')!.label, lang);
const tones = ['mint', 'blue', 'amber', 'stone'];
---
<Base alternates={homeAlternates()} product="docs">
  <DocsHeader alternates={homeAlternates()} />
  <div class="dhome">
    <section class="dh-hero">
      <p class="dh-eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="dh-lead">{lead}</p>
      <button type="button" class="sprompt" data-search-open>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.6"></path></svg>
        <span>{searchPrompt}</span><kbd>/</kbd>
      </button>
    </section>

    <section class="dcards">
      {menu.map((s, i) => (
        <a class:list={['dcard', { lead: i === 0 }, { stars: i === 0 }]} href={s.href}>
          {i === 0 && <svg class="dcard-art" aria-hidden="true" viewBox="0 0 140 90"><ellipse cx="80" cy="50" rx="60" ry="16" fill="none" stroke="rgba(255,255,255,.12)" transform="rotate(-10 80 50)" /><circle cx="80" cy="50" r="22" fill="#0E1C24" stroke="rgba(91,240,200,.45)" /><g transform="translate(132 18) rotate(-20)"><path d="M0 0 L-12 -4 L-9 0 L-12 4 Z" fill="#ECEFF4" /></g></svg>}
          <b>{s.label}</b>
          <span>{s.pages[0]?.data.summary}</span>
          <span class="dcard-go" aria-hidden="true">→</span>
        </a>
      ))}
    </section>

    <section class="dmore">
      {layers && (
        <div class="dlayers">
          <p class="dk">{layers.title}</p>
          {layers.items.map((l, i) => {
            const inner = <><span><b>{l.label}</b> <span>· {l.text}</span></span><span class="tag">{l.tag}</span></>;
            return l.href ? <a class:list={['layer', tones[i % tones.length]]} href={resolveHref(l.href, lang)}>{inner}</a> : <div class:list={['layer', tones[i % tones.length]]}>{inner}</div>;
          })}
        </div>
      )}
      <div class="dquick">
        <p class="dk">{pick(net.label, lang)}{quickData && ` · ${quickData}`}</p>
        <dl>
          <dt>{t.evmChainId}</dt><dd><code>{net.evmChainId}</code></dd>
          <dt>{t.nativeChainId}</dt><dd><code>{net.chainId}</code></dd>
          {evm && <><dt>{evmLabel}</dt><dd><code>{evm.url.replace(/^https?:\/\//, '')}</code></dd></>}
        </dl>
      </div>
    </section>
  </div>
  <Footer />
</Base>

<style>
  .dhome { max-width: 1360px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px) 96px; color: var(--ink); }
  .dh-hero { padding: 56px 0 24px; }
  .dh-eyebrow { margin: 0 0 14px; font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--link); }
  .dh-hero h1 { margin: 0; max-width: 820px; font-size: clamp(32px, 4.4vw, 48px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 500; color: var(--head); }
  .dh-lead { margin: 14px 0 0; max-width: 640px; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .sprompt { margin-top: 28px; display: flex; align-items: center; gap: 12px; min-height: 52px; width: min(560px, 100%); padding: 0 16px; border: 1px solid var(--rule); border-radius: 12px; background: var(--surface); color: var(--muted); font: inherit; font-size: 15px; text-align: left; cursor: pointer; }
  .sprompt:hover { border-color: var(--rule2); }
  .sprompt span { flex: 1; }
  .sprompt kbd { font-family: var(--mono); font-size: 12px; padding: 2px 8px; border: 1px solid var(--rule); border-radius: 6px; }
  .dcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 24px 0; }
  .dcard { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 10px; min-height: 170px; padding: 24px; border-radius: 16px; background: var(--surface); border: 1px solid var(--rule); color: var(--ink); text-decoration: none; transition: border-color .2s; }
  .dcard:hover { border-color: var(--link); }
  .dcard b { font-size: 21px; font-weight: 500; color: var(--head); }
  .dcard span { font-size: 14.5px; line-height: 1.55; color: var(--muted); }
  .dcard .dcard-go { margin-top: auto; color: var(--link); }
  .dcard.lead { background-color: #0E1319; border-color: #0E1319; }
  .dcard.lead b { color: #ECEFF4; }
  .dcard.lead span { color: #A3ADB8; }
  .dcard.lead .dcard-go { color: #5BF0C8; }
  .dcard-art { position: absolute; right: -10px; top: -6px; width: 140px; height: 90px; }
  .dmore { display: flex; flex-wrap: wrap; gap: 32px; padding-top: 32px; }
  .dlayers { flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .dquick { flex: 1 1 340px; min-width: 0; align-self: flex-start; padding: 22px; border-radius: 14px; background: var(--surface); border: 1px solid var(--rule); }
  .dk { margin: 0 0 12px; font-family: var(--mono); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .layer { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; border-radius: 12px; border: 1px solid var(--rule); color: var(--head); text-decoration: none; font-size: 15.5px; }
  .layer b { font-weight: 500; }
  .layer > span > span { color: var(--muted); }
  .layer .tag { font-family: var(--mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; }
  .layer.mint { background: color-mix(in srgb, #5BF0C8 14%, var(--surface)); }
  .layer.blue { background: color-mix(in srgb, #7C9CFF 14%, var(--surface)); }
  .layer.amber { background: color-mix(in srgb, #F2C879 18%, var(--surface)); }
  .layer.stone { background: var(--soft); }
  a.layer:hover { border-color: var(--link); }
  .dquick dl { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 16px; font-size: 14px; }
  .dquick dt { color: var(--muted); }
  .dquick dd { margin: 0; overflow-wrap: anywhere; }
  .dquick code { font-family: var(--mono); color: var(--head); }
  @media (max-width: 900px) { .dcards { grid-template-columns: 1fr; } }
</style>
