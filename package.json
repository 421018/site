{
  "name": "42chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "42 Chain websites (42chain.org and its documentation) and their shared packages.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*",
    "content"
  ],
  "scripts": {
    "dev": "npm run dev -w @42chain/site",
    "dev:docs": "npm run dev -w @42chain/docs",
    "build": "npm run build -w @42chain/site",
    "build:docs": "npm run build -w @42chain/docs",
    "preview": "npm run preview -w @42chain/site",
    "preview:docs": "npm run preview -w @42chain/docs",
    "check": "npm run check --workspaces --if-present",
    "verify": "npm run verify --workspaces --if-present",
    "export:contract": "node tools/export-contract.ts",
    "validate:content": "npm run validate -w @42chain/catalog"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
