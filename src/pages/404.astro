---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { getSiteText } from '../lib/site';
const { notFound } = await getSiteText();
---
<Base title={notFound.title}>
  <section class="band-top" style="min-height: 80vh; display: flex; flex-direction: column">
    <div class="gridbg" aria-hidden="true"></div>
    <Header />
    <div style="position: relative; margin: auto 0; padding: 80px 0">
      <p class="lbl" style="color: var(--fg-4); margin: 0 0 18px">{notFound.label}</p>
      <h1 style="margin: 0; font-size: clamp(40px, 6vw, 80px); font-weight: 600; letter-spacing: -0.045em; line-height: 1">{notFound.heading}</h1>
      <a class="btn btn-g" href="/" style="margin-top: 36px">{notFound.action}</a>
    </div>
  </section>
</Base>
