---
import { GROUPS } from '../data/nav';
interface Props { current?: string }
const { current } = Astro.props;
---
<header class="site-header fade">
  <a class="brand" href="/" aria-label="42 Chain, inicio">
    <span class="mark">42</span><span class="name">42 Chain</span>
  </a>
  <nav class="menu" aria-label="Principal">
    {GROUPS.map((g) => (
      <a class:list={['nl', { on: current === g.key }]} href={g.href} aria-current={current === g.key ? 'true' : undefined}>{g.label}</a>
    ))}
  </nav>
</header>
