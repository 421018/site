---
import { getMenu } from '../lib/site';
interface Props { current?: string }
const { current } = Astro.props;
const menu = await getMenu();
---
<header class="site-header">
  <a class="brand" href="/" aria-label="42 Chain, inicio">
    <span class="mark">42</span><span class="name">42 Chain</span>
  </a>
  <nav class="menu" aria-label="Principal">
    {menu.map((s) => (
      <a class:list={['nl', { on: current === s.key }]} href={s.href} data-label={s.label} aria-current={current === s.key ? 'true' : undefined}>{s.label}</a>
    ))}
  </nav>
</header>
