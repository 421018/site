---
// Illustrative vote count. Thresholds below are examples, not network parameters.
const Q = 33.4, T = 50, V = 33.4;
const sliders = [
  ['turn', 'Participación', 48],
  ['yes', 'Sí', 62],
  ['no', 'No', 18],
  ['veto', 'No con veto', 6],
] as const;
---
<div class="sim" data-vote data-q={Q} data-t={T} data-v={V}>
  <div class="head"><span class="bl">Simulador de conteo</span><span class="bl lc">Ilustrativo: quórum {Q}% · umbral {T}% · veto {V}%</span></div>
  <div class="grid">
    {sliders.map(([k, label, val]) => (
      <div>
        <div class="lab"><label for={'g-' + k}>{label}</label><span class="mono" data-val={k}>{val}%</span></div>
        <input id={'g-' + k} class="range" type="range" min="0" max="100" value={val} data-key={k} />
      </div>
    ))}
  </div>
  <div class="vbar" aria-hidden="true"><span data-w="yes" class="y"></span><span data-w="no" class="n"></span><span data-w="veto" class="x"></span><span data-w="abs" class="a"></span></div>
  <p class="bl lc" data-abs>Abstención: 14% de los votos emitidos</p>
  <div class="chk"><span>Quórum alcanzado</span><span class="mono" data-r="1"></span></div>
  <div class="chk"><span>Sí supera el umbral</span><span class="mono" data-r="2"></span></div>
  <div class="chk"><span>Veto bajo su umbral</span><span class="mono" data-r="3"></span></div>
  <div class="res" role="status"><span class="rt" data-result></span><span class="rn" data-note></span></div>
</div>

<style>
  .sim { margin: 8px 0 32px; padding: clamp(20px, 3vw, 30px); border-radius: 18px; background: var(--panel); border: 1px solid var(--rule); font-size: 15.5px; line-height: 1.6; }
  .bl { font-family: var(--mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .lc { text-transform: none; letter-spacing: 0; }
  .head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
  .lab { display: flex; justify-content: space-between; color: var(--head); }
  .range { width: 100%; accent-color: var(--link); min-height: 40px; }
  .vbar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; background: var(--rule); margin: 14px 0 6px; }
  .vbar span { display: block; height: 100%; transition: width .35s cubic-bezier(.16,1,.3,1); }
  .vbar .y { background: var(--link); } .vbar .n { background: #8E98A3; } .vbar .x { background: #D9644F; } .vbar .a { background: #C9C6BE; }
  p.bl { margin: 0 0 12px; }
  .chk { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--rule); font-size: 14.5px; }
  .chk .ok { color: var(--link); } .chk .bad { color: #B4432F; }
  .res { margin-top: 12px; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--link); display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .res.bad { border-color: #B4432F; }
  .rt { font-size: 18px; font-weight: 600; color: var(--head); }
  .rn { font-size: 14px; color: var(--muted); }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-vote]').forEach((root) => {
    const Q = +root.dataset.q!, T = +root.dataset.t!, V = +root.dataset.v!;
    const st: Record<string, number> = { turn: 48, yes: 62, no: 18, veto: 6 };
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-key]')];
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const paint = () => {
      const abs = Math.max(0, 100 - st.yes - st.no - st.veto);
      const nonAbs = st.yes + st.no + st.veto;
      const ok1 = st.turn >= Q, ok2 = nonAbs > 0 && (st.yes / nonAbs) * 100 > T, ok3 = st.veto < V;
      inputs.forEach((i) => { i.value = String(st[i.dataset.key!]); $(`[data-val=${i.dataset.key}]`).textContent = st[i.dataset.key!] + '%'; });
      $('[data-w=yes]').style.width = st.yes + '%';
      $('[data-w=no]').style.width = st.no + '%';
      $('[data-w=veto]').style.width = st.veto + '%';
      $('[data-w=abs]').style.width = abs + '%';
      $('[data-abs]').textContent = `Abstención: ${abs}% de los votos emitidos`;
      const set = (n: string, ok: boolean, txt: string) => { const e = $(`[data-r="${n}"]`); e.textContent = txt; e.className = 'mono ' + (ok ? 'ok' : 'bad'); };
      set('1', ok1, (ok1 ? 'Sí · ' : 'No · ') + st.turn + '%');
      set('2', ok2, ok2 ? 'Sí' : 'No');
      set('3', ok3, (ok3 ? 'Sí · ' : 'No · ') + st.veto + '%');
      let result = 'Aprobada', note = 'Se cumplen las tres condiciones.';
      if (!ok1) { result = 'No alcanza quórum'; note = 'Se rechaza por falta de participación.'; }
      else if (!ok3) { result = 'Rechazada por veto'; note = 'El veto supera su umbral; el depósito se pierde.'; }
      else if (!ok2) { result = 'Rechazada'; note = 'Los votos a favor no superan el umbral.'; }
      $('[data-result]').textContent = result; $('[data-note]').textContent = note;
      $('.res').classList.toggle('bad', !(ok1 && ok2 && ok3));
    };
    inputs.forEach((i) => i.addEventListener('input', () => {
      const k = i.dataset.key!, v = parseInt(i.value, 10) || 0;
      if (k === 'turn') st.turn = v;
      else { const others = (k === 'yes' ? 0 : st.yes) + (k === 'no' ? 0 : st.no) + (k === 'veto' ? 0 : st.veto); st[k] = Math.max(0, Math.min(v, 100 - others)); }
      paint();
    }));
    paint();
  });
</script>
