---
/**
 * Home page layout. The texts come from content/<lang>/home.md; this file only
 * decides how they look: a magazine that alternates night (cover, brand
 * moments), paper (what is read) and hull (a feature band between two papers).
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../kit/layouts/Base.astro';
import Header from '../kit/components/Header.astro';
import Footer from '../kit/components/Footer.astro';
import { isExternal, langOf, resolveHref } from '../kit/i18n';
import { homeAlternates } from '../kit/site';
import { categoryOf, getBlog, getBlogPosts, postHref, readingMinutes } from '../kit/blog';
import PageRing from '../ui/art/PageRing.astro';
import RingedPlanet from '../ui/art/RingedPlanet.astro';
import Icon from '../ui/art/Icon.astro';

const lang = langOf(Astro);
const entry = await getEntry('home', lang);
if (!entry) throw new Error(`Missing site/${lang}/home.md in the content catalog`);
const { title, description, hero, engine, log, start, name, closing } = entry.data;
// Latest entries of the Bitácora: the featured one (else the newest) large, three more beside it.
const blog = await getBlog(lang);
const posts = blog ? await getBlogPosts(lang) : [];
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const more = posts.filter((p) => p !== lead).slice(0, 3);

/** A line break in a YAML title becomes <br>. */
const lines = (s: string) => s.trim().split('\n');
/** Blank lines separate paragraphs. A single line break stays inside the paragraph. */
const paragraphs = (text: string) =>
  text.split(/\n\s*\n/).map((p) => p.replace(/\s*\n\s*/g, ' ').trim()).filter(Boolean);
type LeadPart = { kind: 'text'; paragraphs: string[] } | { kind: 'lore'; label: string; paragraphs: string[] };
/**
 * Home text is YAML, not Markdown, so a :::lore block inside a lead would
 * otherwise show as plain text. Pull those asides out and leave the rest as paragraphs.
 */
const leadParts = (source: string): LeadPart[] => {
  const parts: LeadPart[] = [];
  const re = /:::lore\[([^\]]+)\]\s*\n([\s\S]*?)\n[ \t]*:::/g;
  let last = 0;
  for (const match of source.matchAll(re)) {
    const before = paragraphs(source.slice(last, match.index));
    if (before.length) parts.push({ kind: 'text', paragraphs: before });
    const quote = paragraphs(match[2]);
    parts.push({ kind: 'lore', label: match[1].trim(), paragraphs: quote.length ? quote : [match[2].trim()] });
    last = (match.index ?? 0) + match[0].length;
  }
  const rest = paragraphs(source.slice(last));
  if (rest.length) parts.push({ kind: 'text', paragraphs: rest });
  return parts;
};
/** Kickers are numbered in page order: 01 — …, 02 — … */
const kicker = (n: number, text: string) => `${String(n).padStart(2, '0')} — ${text}`;
/** A link to another site (42 Protocol) or any external URL shows ↗ instead of the arrow. */
const go = (href: string) => resolveHref(href, lang);
const ext = (href: string) => isExternal(go(href));
const arrow = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8 H13 M9 4 L13 8 L9 12" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>';
---
<Base title={title} description={description} alternates={homeAlternates()}>
<section class="hero">
<div class="hero-sky stars" aria-hidden="true"></div>
<div class="hero-art" aria-hidden="true"><PageRing /></div>
<div class="hero-field" aria-hidden="true"></div>
<div class="hero-in">
<Header alternates={homeAlternates()} />
<div class="copy">
<p class="lbl eyebrow fade" style="animation-delay: .1s"><span class="dot"></span>{hero.eyebrow}</p>
<h1 class="fade" style="animation-delay: .2s">{lines(hero.title).map((l, i) => <>{i > 0 && <br />}{i === 0 ? <span class="panic">{l}</span> : l}</>)}</h1>
<p class="hero-lead fade" style="animation-delay: .35s">{hero.lead}</p>
<div class="acts fade" style="animation-delay: .5s">
<a class:list={['btn btn-p', { ext: ext(hero.primary.href) }]} href={go(hero.primary.href)}>{hero.primary.label}{!ext(hero.primary.href) && <Fragment set:html={arrow} />}</a>
<a class:list={['btn btn-g', { ext: ext(hero.secondary.href) }]} href={go(hero.secondary.href)}>{hero.secondary.label}</a>
</div>
</div>
</div>
</section>

<section id="log" class="band paper">
<div class="wrap">
<div class="headrow">
<div>
<p class="k">{kicker(1, log.kicker)}</p>
<h2 class="h2">{lines(log.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
</div>
<a class="more" href={go(log.link.href)}>{log.link.label} →</a>
</div>
{log.lead && <p class="lead">{log.lead}</p>}
{blog && lead && (
<div class="logs">
<a class="lfeat" href={postHref(blog, lead)}>
{lead.data.image && <figure class="duo limg"><Image src={lead.data.image as never} alt={lead.data.alt!} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 55vw" /></figure>}
<span class="lmeta">{categoryOf(blog, lead).label} · {blog.readingTime.replace('{n}', String(readingMinutes(lead)))}</span>
<b>{lead.data.title}</b>
<span class="lsum">{lead.data.summary}</span>
</a>
{more.length > 0 && <div class="llist">{more.map((p) => (
<a class="litem" href={postHref(blog, p)}>
<span class="lmeta">{categoryOf(blog, p).label}</span>
<b>{p.data.title}</b>
<span class="lsum">{p.data.summary}</span>
</a>
))}</div>}
</div>
)}
</div>
</section>

<section id="engine" class="band casco">
<div class="wrap eng">
<div>
<p class="k">{kicker(2, engine.kicker)}</p>
<h2 class="h2">{lines(engine.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
{engine.lead && (
  <div class="lead-flow">
    {leadParts(engine.lead).map((part) =>
      part.kind === 'lore' ? (
        <aside class="lore">
          {part.paragraphs.map((p) => <p>{p}</p>)}
          <span class="ll">{part.label}</span>
        </aside>
      ) : (
        part.paragraphs.map((p) => <p class="lead">{p}</p>)
      ),
    )}
  </div>
)}
<a class:list={['more', { ext: ext(engine.link.href) }]} href={go(engine.link.href)}>{engine.link.label}{!ext(engine.link.href) && ' →'}</a>
</div>
<svg class="eng-art" viewBox="0 0 440 300" aria-hidden="true"><g fill="none" stroke="rgba(91,240,200,.55)"><rect x="20" y="110" width="80" height="80" rx="12" /><rect x="130" y="110" width="80" height="80" rx="12" /><rect x="240" y="110" width="80" height="80" rx="12" /><rect x="350" y="110" width="70" height="80" rx="12" stroke-dasharray="4 6" /></g><path d="M100 150 H130 M210 150 H240 M320 150 H350" stroke="rgba(242,200,121,.7)" stroke-width="2" /><g fill="#5BF0C8" opacity=".85"><circle cx="60" cy="150" r="5" /><circle cx="170" cy="150" r="5" /><circle cx="280" cy="150" r="5" /></g></svg>
</div>
</section>

<section id="start" class="band paper">
<div class="wrap">
<p class="k">{kicker(3, start.kicker)}</p>
<h2 class="h2">{lines(start.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
{start.lead && <p class="lead">{start.lead}</p>}
<div class="paths">
{start.paths.map((p) => <a class="path" href={go(p.href)}><Icon name={p.icon} size={28} class="pi" /><b class:list={{ ext: ext(p.href) }}>{p.label}</b><span>{p.text}</span></a>)}
</div>
</div>
</section>

<section id="why-42" class="band night stars">
<div class="wrap lore-row">
<div class="lore-text">
<p class="k star">{kicker(4, name.kicker)}</p>
<h2 class="h2">{lines(name.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
{name.lead && <p class="lead">{name.lead}</p>}
{name.link && <a class="more star" href={go(name.link.href)}>{name.link.label} →</a>}
</div>
<div class="lore-art" aria-hidden="true"><RingedPlanet /></div>
</div>
</section>

<section id="closing" class="band night closing">
<div class="wrap">
<h2 class="h2">{closing.title}</h2>
{closing.lead && <p class="lead">{closing.lead}</p>}
<div class="acts">
<a class:list={['btn btn-p', { ext: ext(closing.primary.href) }]} href={go(closing.primary.href)}>{closing.primary.label}{!ext(closing.primary.href) && <Fragment set:html={arrow} />}</a>
<a class:list={['btn btn-g', { ext: ext(closing.secondary.href) }]} href={go(closing.secondary.href)}>{closing.secondary.label}</a>
</div>
</div>
</section>

<Footer />
</Base>

<style is:global>
/* grounds */
.band{padding:112px 0}
.paper{background:var(--bg);color:var(--ink)}
.casco{background:var(--casco);color:#E3ECEB}
.night{background-color:var(--night)}
.wrap{max-width:1280px;margin:0 auto;padding:0 clamp(16px,4vw,40px);box-sizing:border-box}
.k{font-family:var(--mono);font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin:0 0 16px}
.paper .k{color:var(--amber)}
.k.star,.more.star{color:var(--star)}
.h2{margin:0;font-size:clamp(32px,4.8vw,56px);font-weight:500;letter-spacing:-0.035em;line-height:1.04}
.paper .h2{color:var(--head)}
.casco .h2{color:#F1F5F4}
.lead{margin:20px 0 0;max-width:640px;font-size:18px;line-height:1.65;color:var(--fg-3)}
.paper .lead{color:var(--muted)}
.casco .lead{color:#B4C4C2}
.lead-flow{max-width:720px}
.lead-flow .lead{max-width:none}
.lead-flow .lore{margin:22px 0 6px;background:color-mix(in srgb, var(--acc) 8%, var(--hull));color:var(--fg)}
.more{display:inline-flex;align-items:center;min-height:44px;margin-top:24px;color:var(--acc);text-decoration:none;font-size:15px}
.paper .more{color:var(--link);font-weight:500}
.more:hover{text-decoration:underline;text-underline-offset:4px}

/* hero (night) */
.hero{position:relative;overflow:hidden;min-height:clamp(680px,92svh,860px);display:flex;background-color:var(--night)}
.hero-sky{position:absolute;inset:0;opacity:.9}
.hero-art{position:absolute;right:-90px;top:10px;width:min(880px,64vw)}
.hero-field{position:absolute;inset:0;background:linear-gradient(90deg,var(--night) 0%,var(--night) 34%,rgba(4,6,11,.75) 50%,rgba(4,6,11,0) 70%)}
.hero-in{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;max-width:1280px;margin:0 auto;padding:22px clamp(16px,4vw,40px) 72px;box-sizing:border-box}
.hero .copy{flex:1;display:flex;flex-direction:column;justify-content:center;padding:72px 0 24px}
.eyebrow{margin:0 0 28px;display:inline-flex;align-items:center;gap:12px;color:var(--fg-3);letter-spacing:.14em}
.hero h1{margin:0;max-width:760px;font-size:clamp(34px,9.6vw,88px);hyphens:manual;font-weight:500;line-height:.98;letter-spacing:-0.045em}
.hero h1 .panic{color:var(--acc)}
.hero-lead{margin:30px 0 0;max-width:580px;font-size:clamp(17px,1.4vw,19px);line-height:1.6;color:var(--fg-2)}
.acts{display:flex;gap:14px;flex-wrap:wrap;margin-top:40px}
@media (max-width:900px){
.hero-art{right:-35%;top:auto;bottom:-6%;width:130vw;opacity:.45}
.hero-field{background:linear-gradient(180deg,var(--night) 0%,var(--night) 55%,rgba(4,6,11,.6) 100%)}
}

/* bitácora (paper) */
.headrow{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;padding-bottom:20px;border-bottom:1px solid var(--head)}
.headrow .more{margin-top:0}
.logs{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:24px 56px;margin-top:48px}
.logs a{color:var(--ink);text-decoration:none;display:flex;flex-direction:column;gap:10px}
.logs a:hover b{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
.lfeat .limg{margin:0 0 8px;height:360px;border-radius:16px}
.logs b{font-family:var(--serif);font-weight:500;color:var(--head)}
.lfeat b{font-size:clamp(32px,3.4vw,44px);line-height:1.05;letter-spacing:-0.015em}
.lfeat .lsum{font-size:17px}
.llist{display:flex;flex-direction:column}
.litem{padding:24px 0;border-bottom:1px solid var(--rule)}
.litem:first-child{padding-top:0}
.litem:last-child{border-bottom:0}
.litem b{font-size:26px;line-height:1.15}
.lmeta{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--amber)}
.lsum{font-size:15px;line-height:1.6;color:var(--muted)}

/* engine (hull) */
.eng{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:48px;align-items:center}
.eng-art{width:100%;height:auto}

/* ways in (paper) */
.paths{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:44px}
.path{display:flex;flex-direction:column;gap:12px;padding:28px;border-radius:16px;background:var(--card);border:1px solid var(--rule);color:var(--ink);text-decoration:none;transition:border-color .2s}
.path:hover{border-color:var(--link)}
.path .pi{color:var(--link)}
.path b{font-size:19px;font-weight:500;color:var(--head)}
.path span{font-size:15px;line-height:1.55;color:var(--muted)}

/* why 42 (night, full width) */
.lore-row{display:flex;flex-wrap:wrap;align-items:center;gap:32px}
.lore-text{flex:1 1 480px;min-width:0}
.lore-art{flex:1 1 360px;min-width:0;display:flex;justify-content:center}
.lore-art svg{width:100%;max-width:500px;height:auto}

/* closing (night) */
.closing{border-top:1px solid var(--line-d);text-align:center}
.closing .h2{max-width:760px;margin:0 auto}
.closing .lead{max-width:640px;margin:20px auto 0;color:var(--fg-2)}
.closing .acts{justify-content:center}

@media (max-width:900px){
.band{padding:80px 0}
.logs,.paths,.eng{grid-template-columns:1fr}
}
</style>
