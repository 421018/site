---
import { getFooter } from '../lib/site';
import { SITE } from '../config';
const columns = await getFooter();
---
<footer class="site-footer">
  <div class="inner">
    <slot />
    <div class="fcols">
      {columns.map((col) => (
        <div>
          <p class="lbl">{col.label}</p>
          {col.links.map((l) => <a class="flink" href={l.href}>{l.label}</a>)}
        </div>
      ))}
    </div>
    <div aria-hidden="true" class="megatype">42 Chain</div>
    <div class="fbase"><span>42 Chain · Proyecto de código abierto · {SITE.license}</span><span>Desarrollado en abierto</span></div>
  </div>
</footer>
