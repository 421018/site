---
/**
 * Switch between the areas of 42 (Chain · Protocol), from site.md → header.areas.
 * Sits at the far right of the header in every app and stays visible on narrow screens.
 */
import { getSiteText } from '../site';
import { langOf, resolveHref } from '../i18n';
const lang = langOf(Astro);
const areas = (await getSiteText(lang)).header.areas;
---
{areas && (
  <nav class="areas" aria-label={areas.label}>
    {areas.items.map((a) => <a href={resolveHref(a.href, lang)} aria-current={a.current ? 'page' : undefined}>{a.label}</a>)}
  </nav>
)}
<style>
  .areas{display:inline-flex;flex:none;padding:3px;border:1px solid var(--areas-line,rgba(255,255,255,.14));border-radius:10px;background:var(--areas-bg,rgba(255,255,255,.03));font-size:14px}
  .areas a{display:inline-flex;align-items:center;min-height:34px;padding:0 12px;border-radius:7px;color:var(--areas-ink,#A3ADB8);text-decoration:none}
  .areas a:hover{color:var(--areas-on-ink,#ECEFF4)}
  .areas a[aria-current]{background:var(--areas-on,#1B222C);color:var(--areas-on-ink,#ECEFF4);font-weight:500}
</style>
