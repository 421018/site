---
import { getFooter, getSiteText } from '../site';
import { getBlog, getPosts, postHref, categoryOf } from '../blog';
import { isLinkAvailable, langOf, resolveHref } from '../i18n';
const lang = langOf(Astro);
const text = await getSiteText(lang);
const resolve = (links: { label: string; href: string }[]) => links.filter((l) => isLinkAvailable(l.href)).map((l) => ({ ...l, href: resolveHref(l.href, lang) }));
// The footer shared by the areas of 42 (site.md → footer.columns); without it, one column per section.
const columns = text.footer.columns
  ? text.footer.columns.map((c) => ({ key: '', label: c.label, links: resolve(c.links) })).filter((c) => c.links.length)
  : await derived();
const baseLinks = resolve(text.footer.links);

async function derived() {
  const columns = await getFooter(lang);
  // Posts whose category has a path (e.g. use-cases) are listed in that section's column.
  const blog = await getBlog(lang);
  if (blog) {
    for (const p of await getPosts(lang)) {
      const col = columns.find((c) => c.key === categoryOf(blog, p).path);
      col?.links.push({ href: postHref(blog, p), label: p.data.title });
    }
  }
  if (text.footer.extra) columns.push({ key: '', label: text.footer.extra.label, links: resolve(text.footer.extra.links) });
  return columns;
}
---
<footer class="site-footer">
  <div class="inner">
    <slot />
    <div class="fcols">
      {columns.map((col) => (
        <div>
          <p class="lbl">{col.label}</p>
          {col.links.map((l) => <a class="flink" href={l.href}>{l.label}</a>)}
        </div>
      ))}
    </div>
    <div aria-hidden="true" class="megatype"><span class="megatype-note">And remember</span><span class="megatype-word"><span>DON'T</span><span class="megatype-sp"> </span><span>PANIC</span></span></div>
    <div class="fbase"><span>{baseLinks.map((l) => <><a class="flink-b" href={l.href}>{l.label}</a> · </>)}{text.footer.credit} · {text.footer.license}</span><span>{text.footer.note}</span></div>
  </div>
</footer>
