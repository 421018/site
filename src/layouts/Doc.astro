---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SideNav from '../components/SideNav.astro';
import { getSection, sideIndex, prevNext, hrefOf, sectionKey, lastCommitDate, type Page } from '../lib/site';
import { EDIT_BASE } from '../config';

interface Props { page: Page }
const { page } = Astro.props;
const section = await getSection(sectionKey(page));
const home = await getSection(section.home);
const nav = sideIndex(home);
const showSide = nav.items.length + nav.refs.length > 1;
const path = hrefOf(page);
const { prev, next } = prevNext(section, page);
const updated = page.data.updated ?? lastCommitDate(page.filePath);
const fmt = updated && new Intl.DateTimeFormat('es', { dateStyle: 'long' }).format(updated);
---
<Base title={page.data.title} description={page.data.summary} accent={section.accent} ink={section.ink}>
  <section class="band-top">
    <div class="gridbg" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>
    <Header current={home.key} />
  </section>
  <div class="rd">
    <div class="lay">
      {showSide && <SideNav nav={nav} path={path} />}
      <main>
        <div class="dochead">
          <p class="dk">{section.label}</p>
          <h1>{page.data.title}</h1>
          <p class="ds">{page.data.summary}</p>
          <p class="dm">{fmt && <>Última revisión: {fmt} · </>}<a href={EDIT_BASE + page.filePath}>Editar esta página ↗</a></p>
        </div>
        <div class="prose">
          <slot />
        </div>
        {(prev || next) && (
          <nav class="pn" aria-label="Capítulos">
            {prev && <a class="pv" href={prev.href}><span>← Anterior</span>{prev.label}</a>}
            {next && <a class="nx" href={next.href}><span>Siguiente →</span>{next.label}</a>}
          </nav>
        )}
      </main>
    </div>
  </div>
  <Footer />
</Base>
