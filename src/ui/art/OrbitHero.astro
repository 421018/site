---
/**
 * Home hero illustration, "Órbitas": a planet with two orbits, the chain of
 * blocks as satellites and a small ship. Nothing pulses: the inner orbit's
 * dashes drift very slowly and the ship crosses once and stops. With reduced
 * motion everything is still (global.css).
 */
---
<svg class="orbit-hero" aria-hidden="true" viewBox="0 0 900 760" preserveAspectRatio="xMidYMid meet">
  <defs>
    <radialGradient id="oh-planet" cx="35%" cy="30%" r="75%">
      <stop offset="0" stop-color="#1D3A44" /><stop offset=".55" stop-color="#0E1C24" /><stop offset="1" stop-color="#060A10" />
    </radialGradient>
    <linearGradient id="oh-rim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5BF0C8" stop-opacity=".5" /><stop offset=".5" stop-color="#5BF0C8" stop-opacity="0" />
    </linearGradient>
  </defs>
  <ellipse cx="520" cy="420" rx="380" ry="120" fill="none" stroke="rgba(255,255,255,.10)" transform="rotate(-14 520 420)" />
  <ellipse class="orb-flow" cx="520" cy="420" rx="300" ry="92" fill="none" stroke="rgba(91,240,200,.22)" stroke-dasharray="2 6" transform="rotate(-14 520 420)" />
  <circle cx="520" cy="420" r="170" fill="url(#oh-planet)" />
  <circle cx="520" cy="420" r="170" fill="none" stroke="url(#oh-rim)" stroke-width="1.5" />
  <path d="M392 470 Q520 430 648 380" fill="none" stroke="rgba(255,255,255,.05)" stroke-width="18" />
  <g stroke="rgba(91,240,200,.35)"><line x1="196" y1="486" x2="250" y2="510" /><line x1="270" y1="514" x2="330" y2="528" /><line x1="350" y1="532" x2="412" y2="535" /></g>
  <g fill="#0B1018" stroke="#5BF0C8" stroke-opacity=".7" stroke-width="1.2">
    <rect x="176" y="474" width="20" height="20" rx="4" /><rect x="250" y="502" width="20" height="20" rx="4" /><rect x="330" y="520" width="20" height="20" rx="4" /><rect x="412" y="526" width="20" height="20" rx="4" />
  </g>
  <circle cx="822" cy="160" r="26" fill="#121A24" stroke="rgba(255,255,255,.18)" />
  <circle cx="814" cy="152" r="7" fill="rgba(255,255,255,.06)" />
  <path class="ship-trail" d="M600 130 L742 92" stroke="rgba(242,200,121,.5)" stroke-dasharray="1 5" fill="none" />
  <g class="ship-in" transform="translate(748 86)">
    <g transform="rotate(-15)"><path d="M0 0 L-16 -6 L-12 0 L-16 6 Z" fill="#ECEFF4" /><path d="M-12 0 L-22 0" stroke="#F2C879" stroke-width="2" stroke-linecap="round" /></g>
  </g>
</svg>
